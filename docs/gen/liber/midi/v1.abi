package liber:midi@1
record midi-endpoint-id(slot:u32,generation:u32,binding-generation:u64,endpoint:u32,incarnation:u64)
enum midi-protocol(midi1=1,ump=2)
enum midi-direction(receive=1,transmit=2)
record midi-endpoint(id:midi-endpoint-id,name:string:bound=64,protocol:midi-protocol,direction:midi-direction,cables:u8,receiving:bool)
enum midi-chunk-kind(short=1,sysex-start=2,sysex-continue=3,sysex-end=4,raw=5)
record midi-chunk(cable:u8,kind:midi-chunk-kind,bytes:list<u8>:bound=3,sysex-message:option<u32>,start:bool,end:bool)
enum midi-abort-reason(cap=1,malformed=2,interrupted=3,inactivity=4,restarted=5,reset=6)
record midi-abort(cable:u8,message:u32,reason:midi-abort-reason)
enum midi-fault-code(alignment=1,cable=2,reserved=3,status=4,padding=5)
record midi-fault(cable:option<u8>,code:midi-fault-code)
variant midi-item(chunk=0:midi-chunk,aborted=1:midi-abort,fault=2:midi-fault)
record midi-event(header:liber:event@1::event-header,item:midi-item)
record midi-batch(source:liber:event@1::event-source,events:list<midi-event>:bound=64,end:option<liber:event@1::event-end>)
record midi-receiver-status(source:liber:event@1::event-source,queued:u16,queued-bytes:u32,end:option<liber:event@1::event-end>)
interface midi
method midi.endpoints op=1 () -> result<list<midi-endpoint>, liber:base@1::error>:bound=32
method midi.open op=2 (endpoint:midi-endpoint-id:rights=,direction:midi-direction:rights=,protocol:midi-protocol:rights=) -> result<unit, liber:base@1::error>
interface midi-input
method midi-input.endpoint op=1 () -> result<midi-endpoint, liber:base@1::error>
method midi-input.read op=2 (max:u16:rights=,wait-ms:u32:rights=) -> result<midi-batch, liber:base@1::error>
method midi-input.status op=3 () -> result<midi-receiver-status, liber:base@1::error>
method midi-input.stop op=4 () -> result<unit, liber:base@1::error>
record midi-grant(connection:handle<channel>,source:liber:event@1::event-source)
interface midi-admin
method midi-admin.mint op=1 (alias:string:bound=32:rights=,endpoint:u32:rights=,owner:handle<liber:process@1::task>:rights=) -> result<midi-grant, liber:base@1::error>
method midi-admin.revoke op=2 (endpoint:midi-endpoint-id:rights=) -> result<u32, liber:base@1::error>
