package liber:storage@1
resource file
record open-opts(path:string,write:bool,create:bool)
record open-result(file:handle<file>,size:u64)
enum file-type(file=0,dir=1)
record file-info(name:string,size:u64,type:file-type,mtime:u64,ctime:u64)
enum file-event-kind(created=0,modified=1,removed=2)
record file-event(path:string,kind:file-event-kind,size:u64)
enum writer-mode(replace=0,append=1)
record snapshot-info(name:string,generation:u64)
record volume-status(label:string,total-bytes:u64,free-bytes:u64,compression:bool,read-only:bool,filesystem:string)
record fsck-report(checksum-failures:u32,damaged:list<string>,structural-failures:u32,stream-failures:u32,io-failures:u32,faults:list<string>)
interface volume
method volume.open op=1 (o:open-opts:rights=) -> result<open-result, liber:base@1::error>
method volume.list op=2 (path:string:rights=) -> result<stream<file-info>, liber:base@1::error>
method volume.write op=3 (path:string:rights=,data:buffer:rights=) -> result<unit, liber:base@1::error>
method volume.remove op=4 (path:string:rights=) -> result<unit, liber:base@1::error>
method volume.snap-create op=5 (name:string:rights=) -> result<unit, liber:base@1::error>
method volume.snap-list op=6 () -> result<list<snapshot-info>, liber:base@1::error>
method volume.snap-delete op=7 (name:string:rights=) -> result<unit, liber:base@1::error>
method volume.snap-open op=8 (snapshot:string:rights=,path:string:rights=) -> result<open-result, liber:base@1::error>
method volume.mkdir op=9 (path:string:rights=) -> result<unit, liber:base@1::error>
method volume.rmdir op=10 (path:string:rights=) -> result<unit, liber:base@1::error>
method volume.capacity op=11 () -> result<u64, liber:base@1::error>
method volume.status op=12 () -> result<volume-status, liber:base@1::error>
method volume.set-compression op=13 (enabled:bool:rights=) -> result<unit, liber:base@1::error>
method volume.fsck op=14 () -> result<fsck-report, liber:base@1::error>
method volume.restore op=15 (path:string:rights=,snapshot:string:rights=) -> result<unit, liber:base@1::error>
method volume.write-stream op=16 (path:string:rights=,data:handle<channel>:rights=) -> result<unit, liber:base@1::error>
method volume.stat op=17 (path:string:rights=) -> result<file-info, liber:base@1::error>
method volume.rename op=18 (from:string:rights=,to:string:rights=) -> result<unit, liber:base@1::error>
method volume.truncate op=19 (path:string:rights=,length:u64:rights=) -> result<unit, liber:base@1::error>
method volume.touch op=20 (path:string:rights=,create:bool:rights=,at:u64:rights=) -> result<unit, liber:base@1::error>
method volume.read op=21 (path:string:rights=,offset:u64:rights=,length:u32:rights=) -> result<buffer, liber:base@1::error>
method volume.watch op=22 (path:string:rights=) -> result<stream<file-event>, liber:base@1::error>
method volume.open-writer op=23 (path:string:rights=,mode:writer-mode:rights=) -> result<handle<channel>, liber:base@1::error>
method volume.connect op=24 () -> result<handle<channel>, liber:base@1::error>
interface writer
method writer.write op=1 (data:list<u8>:bound=4096:rights=) -> result<u64, liber:base@1::error>
method writer.write-at op=2 (offset:u64:rights=,data:list<u8>:bound=4096:rights=) -> result<unit, liber:base@1::error>
method writer.truncate op=3 (length:u64:rights=) -> result<unit, liber:base@1::error>
method writer.flush op=4 () -> result<u64, liber:base@1::error>
method writer.commit op=5 () -> result<u64, liber:base@1::error>
method writer.abort op=6 () -> result<unit, liber:base@1::error>
interface volume-admin
method volume-admin.open-directory op=1 (path:string:rights=) -> result<handle<channel>, liber:base@1::error>
method volume-admin.open-file op=2 (path:string:rights=,writable:bool:rights=) -> result<handle<channel>, liber:base@1::error>
