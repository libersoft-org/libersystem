package liber:input@1
record pointer-event(col:u16,row:u16,buttons:u8)
record key-event(code:u16,pressed:bool)
record contact-event(id:u8,tip:bool,x:u16,y:u16)
record gamepad-axis(usage:u32,minimum:i32,maximum:i32)
record gamepad(id:u32,label:string:bound=32,axes:list<gamepad-axis>:bound=8,buttons:u8,hats:u8)
record gamepad-state(id:u32,buttons:u32,hats:list<u8>:bound=2,axes:list<i32>:bound=8)
variant gamepad-event(present=0:gamepad,arrived=1:gamepad,state=2:gamepad-state,departed=3:u32)
interface input
method input.subscribe op=1 () -> stream<pointer-event>
method input.subscribe-keys op=2 (focus:handle<channel>:rights=) -> stream<key-event>
method input.subscribe-contacts op=3 (focus:handle<channel>:rights=) -> stream<contact-event>
method input.subscribe-gamepads op=4 (focus:handle<channel>:rights=) -> stream<gamepad-event>
method input.observe-gamepads op=5 () -> stream<gamepad-event>
enum trusted-input-kind(attention=1,armed=2,key=3,lost=4)
record trusted-input(kind:trusted-input-kind,epoch:u64,usage:u16,down:bool)
interface input-trusted
method input-trusted.events op=1 () -> stream<trusted-input>
method input-trusted.arm op=2 (epoch:u64:rights=) -> result<unit, liber:base@1::error>
method input-trusted.disarm op=3 (epoch:u64:rights=) -> result<unit, liber:base@1::error>
interface input-admin
method input-admin.open-keys op=1 () -> result<handle<channel>, liber:base@1::error>
method input-admin.open-gamepads op=2 () -> result<handle<channel>, liber:base@1::error>
interface gamepad-fixture
method gamepad-fixture.attach op=1 (label:string:bound=32:rights=) -> result<u32, liber:base@1::error>
method gamepad-fixture.report op=2 (handle:u32:rights=,buttons:u32:rights=,hat:u8:rights=,axes:list<i32>:bound=4:rights=) -> result<unit, liber:base@1::error>
method gamepad-fixture.detach op=3 (handle:u32:rights=) -> result<unit, liber:base@1::error>
