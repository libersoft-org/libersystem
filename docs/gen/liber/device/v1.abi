package liber:device@1
enum device-type(unknown=0,net=1,block=2,console=3,usb=4)
record device-entry(index:u32,type:device-type,mmio-len:u64,bus:u32,dev:u32,func:u32,present:bool,kind:row-kind,source:platform-source,state:platform-state,identity:string:bound=64,ids:list<platform-id>:bound=8,resources:list<platform-resource>:bound=26,unresolved:bool,companion:string:bound=64,parent:string:bound=16)
enum row-kind(pci=0,platform=1)
enum platform-source(none=0,kernel=1,table=2,tree=3,acpi=4)
enum platform-state(none=0,claimable=1,kernel-held=2,firmware-held=3,reservation=4)
enum platform-id-kind(none=0,hid=1,cid=2,compatible=3,table=4,class=5,identity=6,smbios=7)
record platform-id(kind:platform-id-kind,text:string:bound=46)
enum platform-resource-kind(mmio=0,ports=1,line=2,i2c=3,spi=4,gpio-line=5)
record platform-resource(kind:platform-resource-kind,base:u64,length:u64,level:bool,active-low:bool,controller:u32)
enum binding-state(unbound=0,dependency-pending=1,binding=2,online=3,stopping=4,backoff=5,failed=6,quarantined=7,disabled=8,removed=9,suspended=10)
enum failure-cause(none=0,driver-missing=1,protocol-mismatch=2,claim-refused=3,iommu-required=4,resource-exhausted=5,spawn-failed=6,handshake-timeout=7,driver-exited=8,driver-reported-failure=9,teardown-unconfirmed=10,hung=11,stopped=12,connection-refused=13)
record binding-record(index:u32,bus:u32,dev:u32,func:u32,generation:u64,state:binding-state,cause:failure-cause,attempts:u32,artifact:string,rule:u32,providers:u32,resources:u32,platform:option<u32>,memory-used:u64,memory-peak:u64)
interface device
method device.list op=1 () -> result<list<device-entry>, liber:base@1::error>
method device.get op=2 (index:u32:rights=) -> result<device-entry, liber:base@1::error>
method device.bindings op=3 () -> result<list<binding-record>, liber:base@1::error>
enum provider-kind(block=1,net=2,display=3,audio=4,input=5,usb-bus=6,pointer=7,console-bytes=8,local-stream=9,touch=10,bluetooth-hci=11,power-source=12,fixture-control=13,smartcard-reader=14,modem=15,camera=16,midi=17,printer=18,ptp-transport=19,admin-executor=20,gamepad=21,i2c-bus=22,gpio-lines=23,tpm=24,watchdog=25,ipmi=26,typec-connector=27,platform-switch=28,thermal-zone=29,cooling-device=30,backlight=31,ambient-light=32)
record provider-info(kind:provider-kind,bus:u32,dev:u32,func:u32,binding-generation:u64,slot:u32,provider-generation:u32,live:bool,name:string:bound=48,platform:option<u32>)
enum policy-verb(disable=0,enable=1,select=2,retry=3)
enum policy-outcome(accepted=0,no-such-device=1,not-a-candidate=2,quarantined=3,busy=4,refused=5,not-stored=6)
record incident-report(present:bool,bus:u32,dev:u32,func:u32,generation:u64,state:binding-state,cause:failure-cause,last-opcode:u32,silent-for:u64,attempts:u32,domain-known:bool,memory-used:u64,memory-peak:u64,handles-used:u64,threads-used:u64,dma-used:u64,platform:option<u32>)
interface device-policy-admin
method device-policy-admin.apply op=1 (index:u32:rights=,verb:policy-verb:rights=,artifact:string:rights=) -> result<policy-outcome, liber:base@1::error>
method device-policy-admin.stored op=2 (index:u32:rights=) -> result<string, liber:base@1::error>
method device-policy-admin.incident op=3 (index:u32:rights=) -> result<incident-report, liber:base@1::error>
