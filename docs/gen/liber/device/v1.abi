method provider-catalogue-admin.open-consumer op=1 (kinds:list<provider-kind>:bound=16:rights=) -> result<handle<channel>, liber:base@1::error>
enum hci-packet-kind(command=1,event=2,acl=3,iso=4,sco=5)
record hci-attachment(version:u32,iso:bool,max-command:u32,max-event:u32,max-acl:u32,max-iso:u32,command-credits:u32,acl-credits:u32,acl-queue:u32,epoch:u32,sco:bool,max-sco:u32)
