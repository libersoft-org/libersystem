package liber:hotplug-device@1
record hotplug-status(block-size:u64,region-size:u64,requested:u64,plugged:u64,allowed:u64,in-use:u64)
interface hotplug-device
method hotplug-device.status op=1 () -> result<hotplug-status, liber:base@1::error>
method hotplug-device.allow op=2 (bytes:u64:rights=) -> result<hotplug-status, liber:base@1::error>
