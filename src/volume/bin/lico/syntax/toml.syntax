# TOML, the manifest and configuration format.
lico-syntax 1
name toml
glob *.toml
glob Cargo.lock
max-nesting 1

style text
style comment
style string
style keyword

context root text
context comment comment
context string string
context literal-string string

open root # comment comment
line comment \n text

open root " string string
escape string \\
close string "
# A literal string takes no escapes at all, which is the whole point of the form - a Windows path or
# a regular expression is written once rather than doubled. Giving it its own context is what makes
# that true here rather than approximately true.
open root ' literal-string string
close literal-string '

keyword root true keyword
keyword root false keyword
