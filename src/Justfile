# default: build and run in QEMU
default: run

# build the first system-image shared-object pilot
shared-libs:
    @tools/build-shared.sh x86_64-unknown-none lsrt=rt wire=wire ipc-client=ipc-client base-proto=base-proto process-proto=process-proto display-proto=display-proto input-proto=input-proto security-proto=security-proto session-proto=session-proto storage-proto=storage-proto config-proto=config-proto audio-proto=audio-proto device-proto=device-proto log-proto=log-proto network-proto=network-proto observability-proto=observability-proto resources-proto=resources-proto time-proto=time-proto audio-client=audio-client-provider config-client=config-client-provider device-client=device-client-provider log-client=log-client-provider network-client=network-client-provider observability-client=observability-client-provider process-client=process-client-provider resources-client=resources-client-provider security-client=security-client-provider time-client=time-client-provider volume-client=volume-client-provider pix=pix inflate=inflate deflate=deflate quantize=quantize bmp=bmp png=png apng=apng gif=gif ico=ico icns=icns jpeg=jpeg pcx=pcx ppm=ppm qoi=qoi tga=tga webp=webp keys=keys pcm=pcm surface=surface imgconv=imgconv adpcm=adpcm aiff=aiff flac=flac mp3=mp3 ogg=ogg vorbis=vorbis wav=wav wavpack=wavpack wasm=wasm lico=lico term=term service-util=services

# discard all image caches and rerun the complete compile/link/audit path
shared-libs-verify:
    @LIBER_IMAGE_REBUILD=1 just shared-libs

# Validate warm, one-tool or provider invalidation without retaining source mutations.
shared-cache-check mode="quick":
    tools/check-shared-cache.sh {{ mode }}

# Record one cold, warm, leaf-edit or provider-edit development-loop sample.
dev-baseline scenario tags="smoke":
    @tools/measure-dev-baseline.sh "{{ scenario }}" "{{ tags }}"

# Build and audit one manifest-owned dynamic artifact and its affected closure.
dev-build *arguments:
    @tools/dev-build.sh {{ arguments }}

# Verify the development agent, its artifact registry and the control port's transport are
# absent from the shipping configuration rather than merely refusing to run in it.
development-gate-check:
    tools/check-development-gate.sh

# Reject an ET_EXEC mutation before it can rewrite any target's staged system volume.
static-image-check: sdk user user-aarch64 user-riscv64
    tools/check-static-injection.sh static

# Reject a staged but undeclared DT_NEEDED provider before it can rewrite any target's system volume.
undeclared-edge-check: sdk user user-aarch64 user-riscv64
    tools/check-static-injection.sh undeclared-edge

# Reject duplicate DT_NEEDED metadata before it can rewrite any target's staged system volume.
duplicate-edge-check: sdk user user-aarch64 user-riscv64
    tools/check-static-injection.sh duplicate-edge

# Reject malformed PT_DYNAMIC metadata before it can rewrite any target's staged system volume.
malformed-dynamic-check: sdk user user-aarch64 user-riscv64
    tools/check-static-injection.sh malformed-dynamic

# Reject malformed symbol and relocation metadata before it can rewrite any target's system volume.
malformed-symbol-relocation-check: sdk user user-aarch64 user-riscv64
    tools/check-static-injection.sh malformed-symbol-relocation

# Reject a malformed embedded identity record before it can rewrite any target's system volume.
identity-note-check: sdk user user-aarch64 user-riscv64
    tools/check-static-injection.sh identity-note

# Verify the checked dynamic executable report against all three staged target graphs.
dynamic-report-check: sdk user user-aarch64 user-riscv64
    tools/check-dynamic-report.sh --check

# Regenerate the checked dynamic executable report from all three staged target graphs.
dynamic-report-update: sdk user user-aarch64 user-riscv64
    tools/check-dynamic-report.sh --write

shared-libs-aarch64:
    @tools/build-shared.sh aarch64-unknown-none lsrt=rt wire=wire ipc-client=ipc-client base-proto=base-proto process-proto=process-proto display-proto=display-proto input-proto=input-proto security-proto=security-proto session-proto=session-proto storage-proto=storage-proto config-proto=config-proto audio-proto=audio-proto device-proto=device-proto log-proto=log-proto network-proto=network-proto observability-proto=observability-proto resources-proto=resources-proto time-proto=time-proto audio-client=audio-client-provider config-client=config-client-provider device-client=device-client-provider log-client=log-client-provider network-client=network-client-provider observability-client=observability-client-provider process-client=process-client-provider resources-client=resources-client-provider security-client=security-client-provider time-client=time-client-provider volume-client=volume-client-provider pix=pix inflate=inflate deflate=deflate quantize=quantize bmp=bmp png=png apng=apng gif=gif ico=ico icns=icns jpeg=jpeg pcx=pcx ppm=ppm qoi=qoi tga=tga webp=webp keys=keys pcm=pcm surface=surface imgconv=imgconv adpcm=adpcm aiff=aiff flac=flac mp3=mp3 ogg=ogg vorbis=vorbis wav=wav wavpack=wavpack wasm=wasm lico=lico term=term service-util=services

shared-libs-riscv64:
    @tools/build-shared.sh riscv64gc-unknown-none-elf lsrt=rt wire=wire ipc-client=ipc-client base-proto=base-proto process-proto=process-proto display-proto=display-proto input-proto=input-proto security-proto=security-proto session-proto=session-proto storage-proto=storage-proto config-proto=config-proto audio-proto=audio-proto device-proto=device-proto log-proto=log-proto network-proto=network-proto observability-proto=observability-proto resources-proto=resources-proto time-proto=time-proto audio-client=audio-client-provider config-client=config-client-provider device-client=device-client-provider log-client=log-client-provider network-client=network-client-provider observability-client=observability-client-provider process-client=process-client-provider resources-client=resources-client-provider security-client=security-client-provider time-client=time-client-provider volume-client=volume-client-provider pix=pix inflate=inflate deflate=deflate quantize=quantize bmp=bmp png=png apng=apng gif=gif ico=ico icns=icns jpeg=jpeg pcx=pcx ppm=ppm qoi=qoi tga=tga webp=webp keys=keys pcm=pcm surface=surface imgconv=imgconv adpcm=adpcm aiff=aiff flac=flac mp3=mp3 ogg=ogg vorbis=vorbis wav=wav wavpack=wavpack wasm=wasm lico=lico term=term service-util=services

# build the userspace programs that make up the init package
user: shared-libs
    cd {{ user_dir }} && cargo build
    cd {{ services_dir }} && cargo build {{ dev_features }}
    cd {{ storage_dir }} && cargo build
    cd {{ drivers_dir }} && cargo build {{ dev_features }}

# build the userspace programs for aarch64 (the aarch64 kernel build.rs reads them
# from each crate's aarch64-unknown-none target dir)
user-aarch64: shared-libs-aarch64
    cd {{ user_dir }} && cargo build --target aarch64-unknown-none
    cd {{ services_dir }} && cargo build --target aarch64-unknown-none
    cd {{ storage_dir }} && cargo build --target aarch64-unknown-none
    cd {{ drivers_dir }} && cargo build --target aarch64-unknown-none

# build the WebAssembly component SDK example (the `liber` world guest) for
# wasm32-unknown-unknown; the package builder stages it directly from .build
sdk:
    cd {{ sdk_dir }} && cargo build --release --target wasm32-unknown-unknown

# build the kernel (its build.rs assembles the init package from the userspace build)
# and the own UEFI loader (staged into the boot image as BOOTX64.EFI)
build: sdk user
    cd {{ kernel_dir }} && cargo build
    cd {{ loader_dir }} && cargo build

# generate the proto crate's bindings from the LSIDL interface definitions
# (src/idl/*.lsidl) and format the generated source
gen:
    cd {{ tools_dir }} && cargo run --quiet -- --rust-dir ../../{{ base_proto_dir }}/src --rust-package liber:base@1 ../../idl/*.lsidl
    cd {{ tools_dir }} && cargo run --quiet -- --rust-dir ../../{{ audio_proto_dir }}/src --rust-package liber:audio@1 --external-rust-package liber:base@1=base_proto::generated::liber::base ../../idl/*.lsidl
    cd {{ tools_dir }} && cargo run --quiet -- --rust-dir ../../{{ device_proto_dir }}/src --rust-package liber:device@1 --external-rust-package liber:base@1=base_proto::generated::liber::base ../../idl/*.lsidl
    cd {{ tools_dir }} && cargo run --quiet -- --rust-dir ../../{{ log_proto_dir }}/src --rust-package liber:log@1 --external-rust-package liber:base@1=base_proto::generated::liber::base ../../idl/*.lsidl
    cd {{ tools_dir }} && cargo run --quiet -- --rust-dir ../../{{ network_proto_dir }}/src --rust-package liber:network@1 --external-rust-package liber:base@1=base_proto::generated::liber::base ../../idl/*.lsidl
    cd {{ tools_dir }} && cargo run --quiet -- --rust-dir ../../{{ observability_proto_dir }}/src --rust-package liber:observability@1 --external-rust-package liber:base@1=base_proto::generated::liber::base ../../idl/*.lsidl
    cd {{ tools_dir }} && cargo run --quiet -- --rust-dir ../../{{ resources_proto_dir }}/src --rust-package liber:resources@1 --external-rust-package liber:base@1=base_proto::generated::liber::base ../../idl/*.lsidl
    cd {{ tools_dir }} && cargo run --quiet -- --rust-dir ../../{{ time_proto_dir }}/src --rust-package liber:time@1 --external-rust-package liber:base@1=base_proto::generated::liber::base ../../idl/*.lsidl
    cd {{ tools_dir }} && cargo run --quiet -- --rust-dir ../../{{ config_proto_dir }}/src --rust-package liber:config@1 --external-rust-package liber:base@1=base_proto::generated::liber::base --external-rust-package liber:storage@1=storage_proto::generated::liber::storage ../../idl/*.lsidl
    cd {{ tools_dir }} && cargo run --quiet -- --rust-dir ../../{{ process_proto_dir }}/src --rust-package liber:process@1 --external-rust-package liber:base@1=base_proto::generated::liber::base ../../idl/*.lsidl
    cd {{ tools_dir }} && cargo run --quiet -- --rust-dir ../../{{ display_proto_dir }}/src --rust-package liber:display@1 --external-rust-package liber:base@1=base_proto::generated::liber::base --external-rust-package liber:process@1=process_proto::generated::liber::process ../../idl/*.lsidl
    cd {{ tools_dir }} && cargo run --quiet -- --rust-dir ../../{{ security_proto_dir }}/src --rust-package liber:security@1 --external-rust-package liber:base@1=base_proto::generated::liber::base --external-rust-package liber:process@1=process_proto::generated::liber::process ../../idl/*.lsidl
    cd {{ tools_dir }} && cargo run --quiet -- --rust-dir ../../{{ session_proto_dir }}/src --rust-package liber:session@1 --external-rust-package liber:base@1=base_proto::generated::liber::base --external-rust-package liber:process@1=process_proto::generated::liber::process ../../idl/*.lsidl
    cd {{ tools_dir }} && cargo run --quiet -- --rust-dir ../../{{ input_proto_dir }}/src --rust-package liber:input@1 --external-rust-package liber:base@1=base_proto::generated::liber::base ../../idl/*.lsidl
    cd {{ tools_dir }} && cargo run --quiet -- --rust-dir ../../{{ storage_proto_dir }}/src --rust-package liber:storage@1 --external-rust-package liber:base@1=base_proto::generated::liber::base ../../idl/*.lsidl
    cd {{ tools_dir }} && cargo run --quiet -- --rust-dir ../../{{ proto_dir }}/src --external-rust-package liber:audio@1=audio_proto::generated::liber::audio --external-rust-package liber:base@1=base_proto::generated::liber::base --external-rust-package liber:config@1=config_proto::generated::liber::config --external-rust-package liber:device@1=device_proto::generated::liber::device --external-rust-package liber:display@1=display_proto::generated::liber::display --external-rust-package liber:input@1=input_proto::generated::liber::input --external-rust-package liber:log@1=log_proto::generated::liber::log --external-rust-package liber:network@1=network_proto::generated::liber::network --external-rust-package liber:observability@1=observability_proto::generated::liber::observability --external-rust-package liber:process@1=process_proto::generated::liber::process --external-rust-package liber:resources@1=resources_proto::generated::liber::resources --external-rust-package liber:security@1=security_proto::generated::liber::security --external-rust-package liber:session@1=session_proto::generated::liber::session --external-rust-package liber:storage@1=storage_proto::generated::liber::storage --external-rust-package liber:time@1=time_proto::generated::liber::time --docs-dir ../../../docs/gen ../../idl/*.lsidl
    cd {{ base_proto_dir }} && cargo fmt
    cd {{ audio_proto_dir }} && cargo fmt
    cd {{ device_proto_dir }} && cargo fmt
    cd {{ log_proto_dir }} && cargo fmt
    cd {{ network_proto_dir }} && cargo fmt
