# Explicitly accept an intentional pre-release breaking ABI-manifest change.
gen-accept-breaking:
    cd {{ tools_dir }} && cargo run --quiet -- --accept-breaking --rust-dir ../../{{ base_proto_dir }}/src --rust-package liber:base@1 ../../idl/*.lsidl
    cd {{ tools_dir }} && cargo run --quiet -- --accept-breaking --rust-dir ../../{{ audio_proto_dir }}/src --rust-package liber:audio@1 --external-rust-package liber:base@1=base_proto::generated::liber::base ../../idl/*.lsidl
