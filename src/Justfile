# Development commands
# Run from the src/ directory (where this Justfile lives).

kernel_dir := "kernel"
# The development configuration: the development agent, its artifact registry and the control
# port's transport. Off unless LIBER_DEVELOPMENT=1, so an ordinary build - and every test and
# shipping build - does not contain those units at all. `dev-up` sets it; nothing else does.
# The kernel needs no flag: its build script reads the variable directly, which is also the
# only way it reliably notices the configuration changing.
dev_features := if env_var_or_default("LIBER_DEVELOPMENT", "0") == "1" { "--features development" } else { "" }
