    cd {{ time_proto_dir }} && cargo fmt
    cd {{ config_proto_dir }} && cargo fmt
    cd {{ process_proto_dir }} && cargo fmt
    cd {{ display_proto_dir }} && cargo fmt
    cd {{ security_proto_dir }} && cargo fmt
    cd {{ session_proto_dir }} && cargo fmt
    cd {{ input_proto_dir }} && cargo fmt
    cd {{ storage_proto_dir }} && cargo fmt
    cd {{ proto_dir }} && cargo fmt

