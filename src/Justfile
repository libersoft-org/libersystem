# build + boot, QEMU waits for GDB (port :1234)
debug:
    ../run.sh --debug

# attach GDB to a running QEMU (run in a second panel after 'just debug')
gdb:
    gdb -x boot/gdb-init {{ kernel_elf }}

# Exercise x86_64 SMP bring-up at the host core count as a checkpoint gate.
test-smp-checkpoint:
    SMP="$(nproc)" boot/test-kernel.sh x86_64 "smp"

# Run all tests on all architectures. TCG guests are intentionally serial to avoid
# host contention; this is the periodic integration check, not the per-task path.
test-all: test-tags-check
    boot/test-all.sh

# Cheap source and manifest checks; the Rust type system separately rejects
# unknown/empty tags, and the image builder verifies actual ELF metadata.
test-tags-check: services-host-test
    boot/check-test-tags.sh

# Answer whether the staged system images on disk are the ones this tree produces, by
# hashing every declared artifact against the digest the build recorded when it staged it.
# Runs before every kernel test suite as part of the preflight (a fifth of a second), and
# is here as its own recipe because "is my staged image stale" is a question worth being
# able to ask directly - a stale one stalls a boot with no error, and that reads exactly
# like a code defect. With no argument every target that has a staged image is checked.
staged-image-check *targets:
    tools/check-staged-image.sh {{ targets }}

# Reject generated or compiled artifacts anywhere below src or in the Git index.
source-hygiene:
    tools/check-source-hygiene.sh --current

# Reject generated artifacts anywhere in reachable Git history.
source-history-hygiene:
    tools/check-source-hygiene.sh --history

# build the own UEFI loader for aarch64 (staged into the boot image as BOOTAA64.EFI)
loader-aarch64:
    cd {{ loader_dir }} && cargo build --target aarch64-unknown-uefi

# build the own UEFI loader for riscv64 (staged into the boot image as BOOTRISCV64.EFI).
# There is no built-in riscv64 UEFI rustc target (and rustc's object backend cannot emit
# a riscv64 PE/COFF), so the loader is compiled as a static PIE on the ELF target and a
# hand-written PE/COFF header (src/arch/riscv64/head.rs) is prepended via the linker
# script (loader/riscv64-pe.ld); llvm-objcopy then flattens it into a valid EFI
# application, padded to the image end so its section raw data is fully backed.
loader-riscv64:
    #!/usr/bin/env bash
    set -euo pipefail
    # Built from the loader's own directory so cargo reads ITS `.cargo/config.toml`. Run with
    # `--manifest-path` from elsewhere, cargo takes the configuration of the working directory
    # instead - which has no `build-std` for this target, so the build failed with "can't find
    # crate for core" and the recipe had been red for as long as anyone had looked.
    cd {{ loader_dir }}
    RUSTFLAGS="-C relocation-model=pic -C link-arg=-pie -C link-arg=-T$PWD/riscv64-pe.ld" \
        cargo build --target riscv64gc-unknown-none-elf
    out="../../.build/cargo/loader/riscv64gc-unknown-none-elf/debug/libersystem-loader"
    end=$(llvm-readelf -s "$out" | awk '/ _pe_image_end$/{print "0x"$2; exit}' || true)
    [[ -n "$end" ]] || { echo "loader-riscv64: no _pe_image_end symbol in $out" >&2; exit 1; }
    llvm-objcopy -O binary --pad-to "$end" "$out" "$out.efi"
    echo "loader-riscv64: wrote $out.efi"

# screenshot the framebuffer to a file (format by extension: png/jpg/webp/...);
# snaps a live `./run.sh` if one is up, else boots a throwaway. e.g. just screenshot shot.png
screenshot path:
    boot/screenshot.sh {{ path }}

# drive a live instance for debugging: boot it, run shell commands in it and get
# their output back, tail the serial log, capture packets, type on the keyboard.
# e.g. `just lab boot --fresh`, `just lab sh time ls`, `just lab help`
lab *args:
    boot/lab.py {{ args }}

# run the development-control protocol's conformance suite against the running instance, all
# groups or the named ones. e.g. `just proto-test`, `just proto-test registry publication`
proto-test *groups:
    @boot/proto-test.py {{ groups }}

# measure one warm no-change build and one warm leaf iteration against the running instance,
# and fail when either misses its budget or the rebuild stops being proportional
perf-gate:
    @boot/perf-gate.py

# run scenarios against a cold boot of any target, with no persistent instance: builds that
# target with the development profile, boots one guest, drives it over the same control protocol
# and takes it down. This is what lets an application scenario be exercised on aarch64 and
# riscv64, where the persistent instance does not exist.
scenario-cold *args:
    @boot/lab.py scenario-cold {{ args }}

