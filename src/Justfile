# discard all image caches and rerun the complete compile/link/audit path
shared-libs-verify:
    @LIBER_IMAGE_REBUILD=1 ../build.sh --part libs

# Prove a targeted build and the authoritative rebuild produce the same bytes, over a leaf
# executable, a provider with consumers and the runtime provider. Both sides rebuild for real.
fast-path-check target="x86_64" *artifacts:
    tools/check-fast-path-parity.sh {{ target }} {{ artifacts }}

# Validate warm, one-tool or provider invalidation without retaining source mutations.
shared-cache-check mode="quick":
    tools/check-shared-cache.sh {{ mode }}

# Regenerate the checked dynamic executable report from all three staged target graphs.
dynamic-report-update:
    tools/check-dynamic-report.sh --write

