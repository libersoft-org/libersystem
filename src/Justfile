# Host-test the shared boot contract: the ELF reader, SHA-256 and the provider
# compatibility rule. The rule reads only image bytes, so it is fully decidable on the host
# and its fixtures never need a guest.
bootproto-host-test:
    cargo test --manifest-path {{ bootproto_dir }}/Cargo.toml --target x86_64-unknown-linux-gnu

# Host-test pure service parsing, graph bounds, and lifecycle planning.
services-host-test:
    CARGO_TARGET_DIR={{ build_root }}/cargo/services-host cargo test --manifest-path {{ services_dir }}/Cargo.toml --lib --target x86_64-unknown-linux-gnu

# Host-test every filesystem: LiberFS, FAT, ISO9660, UDF and LiberMemFS, plus the error and
# BlockDevice contract they share. These are pure host tests - a filesystem decides what it does
# from its own bytes, so none of them needs a guest - and they were reachable only by hand until
# now, which meant 217 tests guarded nothing. The three-target QEMU suites exercise the storage
# service through IPC; they do not cover a filesystem's own edge cases.
fs-host-test:
    cargo test --manifest-path {{ fscore_dir }}/Cargo.toml --target x86_64-unknown-linux-gnu
    cargo test --manifest-path {{ liberfs_dir }}/Cargo.toml --target x86_64-unknown-linux-gnu
    cargo test --manifest-path {{ libermemfs_dir }}/Cargo.toml --target x86_64-unknown-linux-gnu
    cargo test --manifest-path {{ fat_dir }}/Cargo.toml --target x86_64-unknown-linux-gnu
    cargo test --manifest-path {{ iso9660_dir }}/Cargo.toml --target x86_64-unknown-linux-gnu
    cargo test --manifest-path {{ udf_dir }}/Cargo.toml --target x86_64-unknown-linux-gnu

# Measure the staged MP3 decoder in an optimized host build and fail below real time.
audio-bench:
    cargo run --release --manifest-path {{ audio_bench_dir }}/Cargo.toml

# Measure current image encode/decode profiles in an optimized host build.
image-bench:
    cargo run --release --manifest-path {{ image_bench_dir }}/Cargo.toml

# Run every image leaf and the central sniffer through deterministic hostile inputs.
image-mutate:
    cargo run --release --manifest-path {{ image_mutate_dir }}/Cargo.toml
