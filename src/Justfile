# Run all tests on all architectures. TCG guests are intentionally serial to avoid
# host contention; this is the periodic integration check, not the per-task path.
test-all: sdk user user-aarch64 user-riscv64 test-tags-check
    boot/test-all.sh

# Cheap source and manifest checks; the Rust type system separately rejects
# unknown/empty tags, and the image builder verifies actual ELF metadata.
test-tags-check: artifact-metadata-check services-host-test
    boot/check-test-tags.sh

artifact-metadata-check:
    tools/check-artifact-metadata.sh

volume-layout-check: build
    tools/system-manifest.sh check-volume-package ../.build/boot/volume.pkg

# Reject generated or compiled artifacts anywhere below src or in the Git index.
source-hygiene:
    tools/check-source-hygiene.sh --current

# Reject generated artifacts anywhere in reachable Git history.
source-history-hygiene:
    tools/check-source-hygiene.sh --history

# build the own UEFI loader for aarch64 (staged into the boot image as BOOTAA64.EFI)
loader-aarch64:
    cd {{ loader_dir }} && cargo build --target aarch64-unknown-uefi

# build the own UEFI loader for riscv64 (staged into the boot image as BOOTRISCV64.EFI).
# There is no built-in riscv64 UEFI rustc target (and rustc's object backend cannot emit
# a riscv64 PE/COFF), so the loader is compiled as a static PIE on the ELF target and a
# hand-written PE/COFF header (src/arch/riscv64/head.rs) is prepended via the linker
# script (loader/riscv64-pe.ld); llvm-objcopy then flattens it into a valid EFI
# application, padded to the image end so its section raw data is fully backed.
loader-riscv64:
    RUSTFLAGS="-C relocation-model=pic -C link-arg=-pie -C link-arg=-T$PWD/loader/riscv64-pe.ld" \
        cargo build --manifest-path {{ loader_dir }}/Cargo.toml --target riscv64gc-unknown-none-elf &&
    END=$(llvm-readelf -s {{ cargo_loader_dir }}/riscv64gc-unknown-none-elf/debug/libersystem-loader | awk '/ _pe_image_end$/{print "0x"$2; exit}') &&
    llvm-objcopy -O binary --pad-to "$END" \
        {{ cargo_loader_dir }}/riscv64gc-unknown-none-elf/debug/libersystem-loader \
        {{ cargo_loader_dir }}/riscv64gc-unknown-none-elf/debug/libersystem-loader.efi

# build + boot the ARM64 build in QEMU (native on an aarch64 host, emulated on an x86
# host), reaching the interactive shell over the serial console. Uses QEMU's direct
# -kernel load - the quick path; `run-aarch64-uefi` boots the same system through the
# own UEFI loader. Add live displays as arguments (combinable): `just run-aarch64 vnc spice`.
run-aarch64 *displays: sdk user-aarch64
    cd {{ kernel_dir }} && cargo build --target aarch64-unknown-none
    DISPLAYS="{{ displays }}" SERIAL=stdio bash boot/qemu-run.sh aarch64 {{ cargo_kernel_dir }}/aarch64-unknown-none/debug/kernel

# build the userspace programs for riscv64 (the riscv64 kernel build.rs reads them from
# each crate's riscv64gc-unknown-none-elf target dir)
user-riscv64: shared-libs-riscv64
    cd {{ user_dir }} && cargo build --target riscv64gc-unknown-none-elf
    cd {{ services_dir }} && cargo build --target riscv64gc-unknown-none-elf
    cd {{ storage_dir }} && cargo build --target riscv64gc-unknown-none-elf
    cd {{ drivers_dir }} && cargo build --target riscv64gc-unknown-none-elf

# build + boot the riscv64 build in QEMU over OpenSBI (emulated on an x86 host),
# reaching the pinned userspace service chain over the serial console. The system
# volume is a polled virtio-blk disk (StorageService reads the factory archive from
# it), so no per-device interrupt path is needed for the core chain.
run-riscv64 *displays: sdk user-riscv64
    cd {{ kernel_dir }} && cargo build --target riscv64gc-unknown-none-elf
    DISPLAYS="{{ displays }}" SERIAL=stdio bash boot/qemu-run.sh riscv64 {{ cargo_kernel_dir }}/riscv64gc-unknown-none-elf/debug/kernel

# build + boot the full riscv64 system through the own UEFI loader under U-Boot (the
# qemu-riscv64 S-mode U-Boot on OpenSBI, instead of QEMU's direct -kernel load): U-Boot's
# EFI boot manager launches /EFI/BOOT/BOOTRISCV64.EFI off the FAT ESP, which reads the
# kernel off the same volume, places it at its physical link addresses and enters the
# kernel's boot stub - the same entry state OpenSBI's -kernel boot produces.
run-riscv64-uefi *displays: sdk user-riscv64 loader-riscv64
    cd {{ kernel_dir }} && cargo build --target riscv64gc-unknown-none-elf
    UEFI=1 DISPLAYS="{{ displays }}" SERIAL=stdio bash boot/qemu-run.sh riscv64 {{ cargo_kernel_dir }}/riscv64gc-unknown-none-elf/debug/kernel

# build + boot the full aarch64 system through the own UEFI loader under the AAVMF
# firmware (instead of QEMU's direct -kernel load), reaching the interactive shell.
# Add live displays as arguments (combinable): `just run-aarch64-uefi vnc spice`.
run-aarch64-uefi *displays: sdk user-aarch64 loader-aarch64
    cd {{ kernel_dir }} && cargo build --target aarch64-unknown-none
    UEFI=1 DISPLAYS="{{ displays }}" SERIAL=stdio bash boot/qemu-run.sh aarch64 {{ cargo_kernel_dir }}/aarch64-unknown-none/debug/kernel

# screenshot the framebuffer to a file (format by extension: png/jpg/webp/...);
# snaps a live `just run` if one is up, else boots a throwaway. e.g. just screenshot shot.png
screenshot path: build
    boot/screenshot.sh {{ path }}

# drive a live instance for debugging: boot it, run shell commands in it and get
# their output back, tail the serial log, capture packets, type on the keyboard.
# e.g. `just lab boot --fresh`, `just lab sh time ls`, `just lab help`
lab *args:
    boot/lab.py {{ args }}

# boot one development guest and keep it alive so later commands reuse it instead of
# paying for a boot each time. One instance owns the profile at a time; a second caller
# is told who holds it and how to release it. e.g. `just dev-up`, `just dev-up --vnc`
dev-up *args:
    boot/lab.py dev-up {{ args }}

# report the development instance state: down, starting, ready, stale or foreign.
# Exits 0 only when it is ready, so scripts can gate on it.
dev-status:
    @boot/lab.py dev-status

# attach an interactive terminal to the development instance and replay its recent
# output. Ctrl-] detaches without stopping the guest. One client owns keyboard input;
# `just dev-console --read-only` attaches further observers. e.g. `just dev-console`
dev-console *args:
    @boot/lab.py dev-console {{ args }}

# show, follow or grep the development instance serial log. e.g. `just dev-log -f`
dev-log *args:
    @boot/lab.py dev-log {{ args }}

# exercise the development-control protocol over the instance's control channel:
# handshake, then round-trip echoed frames. e.g. `just dev-ping --count 5 --size 4096`
dev-ping *args:
    @boot/lab.py dev-ping {{ args }}

# stream a file into the development instance's artifact registry, checked against its
# digest by the guest. e.g. `just dev-publish shell ../.build/system-image/.../shell`
dev-publish *args:
    @boot/lab.py dev-publish {{ args }}

# list the artifact generations the development instance holds
dev-generations *args:
    @boot/lab.py dev-generations {{ args }}

# type into the development instance's terminal over the control channel, and get back the
# byte count its console accepted. e.g. `just dev-type ls -l`
dev-type *args:
    @boot/lab.py dev-type {{ args }}

# drop the development state the instance holds (registry and any open candidate); not a
# reboot, and it reports exactly what it dropped
dev-reset *args:
    @boot/lab.py dev-reset {{ args }}

# replace the instance's development agent with a fresh one and wait until it serves; the
# guest keeps running and the registry goes with the old agent
dev-restart *args:
    @boot/lab.py dev-restart {{ args }}

# return an artifact in the development instance registry to the generation before its
# newest. e.g. `just dev-rollback base-proto`
dev-rollback *args:
    @boot/lab.py dev-rollback {{ args }}

# run declarative application scenarios against the development instance. Scenario data is
# versioned, bounded and has no way to express a shell command.
# e.g. `just dev-scenario boot/scenarios/*.toml`
dev-scenario *args:
    @boot/lab.py dev-scenario {{ args }}

# launch a canonical program in the development instance through PermissionManager and print
# what it writes. e.g. `just dev-launch uname`
dev-launch *args:
    @boot/lab.py dev-launch {{ args }}

# stop the development instance gracefully and release its lock
dev-down *args:
    @boot/lab.py dev-down {{ args }}

# build a bootable hybrid ISO (BIOS + UEFI) -> .build/boot/<product>.iso; STRIP=debug|all
iso strip="debug": build
    STRIP={{ strip }} boot/mkimage.sh iso {{ kernel_elf }}

# build a raw bootable disk image for USB / SD card / HDD (BIOS + UEFI); SIZE e.g. 128M, 1G; STRIP=debug|all
img size="64M" strip="debug": build
    STRIP={{ strip }} boot/mkimage.sh img {{ kernel_elf }} {{ size }}

