//! LiberSystem cameras - bounded formats, explicitly started capture into buffers the CLIENT owns, and
//! honest timing and loss.
//!
//! THREE PARTIES. An ordinary client holds `camera`: it lists cameras and reads their formats, and has
//! no operation that starts anything or reaches a frame. A client PermissionManager granted capture holds
//! a `camera-capture` connection minted through the private `camera-admin` for ONE camera and the life of
//! one launched component; it negotiates, registers its own buffers and starts explicitly. A PROVIDER -
//! the USB Video class module, or the in-guest fixture - serves `liber:camera-device@1`, and CameraService
//! is its one consumer.
//!
//! THE CLIENT OWNS THE MEMORY. Frames are written into memory objects the client created and keeps
//! paying for; the service holds handles and metadata only, and allocates no frame storage on a client's
//! behalf. A completed buffer is LEASED to the client until it gives that exact lease back; nothing
//! overwrites it meanwhile, and when no buffer is queued a new frame is dropped and counted, never
//! queued without bound.
//!
//! TIME IS WHAT WAS MEASURED. Every frame carries the host time it was assembled at, in the boot's
//! monotonic nanoseconds; the device's own clock rides beside it only when the device gave one, as raw
//! ticks with its width, its frequency when known, its domain and its reset generation - never
//! converted, never subtracted from a clock it is not correlated with.

package liber:camera@1;

use liber:base@1.{error};
use liber:process@1.{task};

/// A memory object the CLIENT created, for the camera to fill.
///
/// `@kernel(memory-object)` is what makes the `@rights` guard on `register` refuse a handle of any other
/// kernel object rather than checking rights on whatever it was handed.
@kernel(memory-object)
resource frame-buffer;

/// A camera as this service knows it: DeviceManager's publication identity and the incarnation of the
/// service that issued the handle. A replaced camera is another camera, and a new authority decision.
record camera-id {
	slot:               u32,
	generation:         u32,
	binding-generation: u64,
	incarnation:        u64,
}

/// The frame types this system carries: packed 4:2:2 YUV, and Motion-JPEG as OPAQUE encoded data for the
/// existing JPEG decoder leaf. Anything else is refused, never reinterpreted.
enum frame-type {
	yuy2  = 1,
	mjpeg = 2,
}

enum color-range {
	unknown = 0,
	limited = 1,
	full    = 2,
}

enum color-matrix {
	unknown = 0,
	bt601   = 1,
	bt709   = 2,
}

/// A frame interval, as a rational number of seconds.
record interval {
	numerator:   u32,
	denominator: u32,
}

record discrete-intervals {
	@bound(32) values: list<interval>,
}

/// A continuous range: checked bounds and a step, never an expanded list.
record interval-range {
	minimum: interval,
	maximum: interval,
	step:    interval,
}

variant intervals {
	discrete(discrete-intervals),
	stepwise(interval-range),
}

record frame-size {
	index:     u8,
	width:     u16,
	height:    u16,
	max-bytes: u32,
	intervals: intervals,
}

record format-info {
	index:      u8,
	frame-type: frame-type,
	compressed: bool,
	sizes:      u8,
	range:      color-range,
	matrix:     color-matrix,
}

/// One camera, listed: no frame, no buffer, no way to start anything.
record camera-info {
	id:                   camera-id,
	@bound(64) name:      string,
	@bound(8) formats:    list<format-info>,
	/// The descriptor snapshot the formats belong to; a page read under another one is stale.
	generation:           u64,
	/// A stream is running on it - for anybody.
	streaming:            bool,
	/// False while a stop was not confirmed and its buffers are quarantined.
	available:            bool,
}

/// A page of one format's frame sizes, under a snapshot generation.
record format-page {
	generation:        u64,
	format:            format-info,
	offset:            u8,
	@bound(8) sizes:   list<frame-size>,
	total:             u8,
}

record stream-request {
	format:   u8,
	size:     u8,
	interval: interval,
}

/// What was selected - exactly what was asked for, or the request was refused.
record negotiated {
	stream-generation: u64,
	format:            u8,
	frame-type:        frame-type,
	width:             u16,
	height:            u16,
	interval:          interval,
	max-bytes:         u32,
	/// For YUY2, the checked row stride and plane offset; zero for encoded data.
	stride:            u32,
	plane-offset:      u32,
	range:             color-range,
	matrix:            color-matrix,
}

/// The device's own clock, as it gave it: raw ticks modulo 2^width, in a named domain whose reset
/// generation changes whenever it reset or its continuity could not be established.
record device-time {
	ticks:            u64,
	width-bits:       u8,
	frequency-hz:     option<u64>,
	clock-domain:     u32,
	reset-generation: u32,
}

record frame {
	stream-generation: u64,
	/// This stream's observation sequence: every frame the camera delivered or definitely dropped
	/// advanced it, so a gap here is a known loss.
	sequence:          u64,
	buffer:            u8,
	lease:             u64,
	valid-bytes:       u32,
	/// When the complete frame was ready for handoff, in `clock_ns()` since this boot.
	arrival-ns:        u64,
	device:            option<device-time>,
}

/// One coalesced status: always the newest, kept apart from the four completions so a terminal or loss
/// state is observable when every buffer is leased.
record capture-status {
	stream-generation:       u64,
	streaming:               bool,
	next-sequence:           u64,
	dropped-no-buffer:       u64,
	dropped-device:          u64,
	/// Losses whose frame count nobody could establish.
	unknown-discontinuities: u64,
	/// Why the stream ended, once it has.
	ended:                   option<error>,
}

variant capture-event {
	frame(frame),
	status(capture-status),
}

/// INVENTORY: cameras and their formats. No capture, no buffer, no start.
interface camera {
	@op(1) @bound(4) cameras: func() -> result<list<camera-info>, error>;
	@op(2) sizes: func(camera: camera-id, generation: u64, format: u8, offset: u8) -> result<format-page, error>;
}

/// CAPTURE on the one camera this connection was minted for, for as long as its owner lives. Nothing
/// starts until `start`; renegotiating needs `stop` first, and a stopped stream is retired - a new one
/// registers its own buffers.
interface camera-capture {
	@op(1) camera:    func() -> result<camera-info, error>;
	@op(2) sizes:     func(generation: u64, format: u8, offset: u8) -> result<format-page, error>;
	@op(3) negotiate: func(request: stream-request) -> result<negotiated, error>;
	/// At most four buffers, each at most 8 MB and 32 MB in all; the same backing once per stream.
	@op(4) register:  func(@rights(map, write) buffer: handle<frame-buffer>) -> result<u8, error>;
	@op(5) start:     func() -> result<unit, error>;
	@op(6) events:    func() -> stream<capture-event>;
	/// Give back exactly the lease a frame carried; the buffer is queued for the camera again.
	@op(7) release:   func(buffer: u8, lease: u64) -> result<unit, error>;
	/// Answered once the camera has returned every buffer it held.
	@op(8) stop:      func() -> result<unit, error>;
	@op(9) status:    func() -> result<capture-status, error>;
}

record capture-grant {
	connection: handle<channel>,
	camera:     camera-id,
}

/// THE MINTING ENDPOINT, PermissionManager's alone. The alias names a camera the service's configuration
/// binds to provider metadata, and resolves to exactly one current publication or the mint fails.
interface camera-admin {
	@op(1) mint: func(@bound(32) alias: string, owner: handle<task>) -> result<capture-grant, error>;
	/// Revoke every capture grant on one camera: their streams stop as a closed connection's would, and a
	/// client has to be granted again. Answers how many grants ended.
	@op(2) revoke: func(camera: camera-id) -> result<u32, error>;
}
