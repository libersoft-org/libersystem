//! LiberSystem printers - the private backend contract a `printer` publication serves to SpoolService.
//!
//! A BACKEND MOVES BYTES AND REPORTS THE PORT; THE SERVICE OWNS EVERYTHING ELSE. The USB printer class module,
//! and the kernel test sink before it, attach under a version and an attachment generation, report the IEEE
//! 1284 device ID and the port status byte, and accept a prefix of each write. Admission, ordering, deadlines,
//! reset and recovery are SpoolService's; there is no arbitrary control request.

package liber:printer-device@1;

use liber:base@1.{error};

record printer-attach {
	version:              u32,
	/// A new attachment - after a reset or a reattachment - is a new generation.
	attachment:           u64,
	/// The IEEE 1284 device ID exactly as the printer gave it, its two-byte length included.
	@bound(4096) device-id: list<u8>,
}

/// The port as the backend read it: the class-defined status byte, and the two details a backend with evidence
/// of them supplies. An absent detail is no evidence, never `false`.
record port-reading {
	bits:       u8,
	cover-open: option<bool>,
	jam:        option<bool>,
}

/// THE BACKEND CONTRACT a `printer` publication serves - to SpoolService alone. One write outstanding at a
/// time, at most 4096 bytes; the answer is how many bytes of its PREFIX were accepted, or `again` for none.
interface printer-backend {
	@op(1) attach:      func(version: u32) -> result<printer-attach, error>;
	@op(2) port-status: func(attachment: u64) -> result<port-reading, error>;
	@op(3) write:       func(attachment: u64, @bound(4096) bytes: list<u8>) -> result<u32, error>;
	/// Reset the port. A new attachment generation on success; the attachment is gone either way.
	@op(4) reset:       func(attachment: u64) -> result<printer-attach, error>;
}
