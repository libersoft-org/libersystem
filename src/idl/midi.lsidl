//! LiberSystem MIDI - MIDI 1.0 receive endpoints, as ordered bounded chunks with their host receipt time and
//! cable, for components PermissionManager granted one endpoint.
//!
//! THREE PARTIES. An ordinary client holds `midi`: it lists endpoints and can open nothing - receiving and
//! sending each need a grant, and UMP is not supported at all yet. A client PermissionManager granted
//! `midi-input` holds a receiver, and one granted `midi-output` a sender, minted through the private
//! `midi-admin` for ONE endpoint of one publication and the life of one launched component. A PROVIDER - the
//! USB MIDI class module, or the in-guest fixture - serves `liber:midi-device@1`, and MidiService is its one
//! consumer.
//!
//! SENDING IS THE SAME CHUNKS THE OTHER WAY. A sender hands over complete short messages and SysEx fragments
//! under message numbers of its own choosing; MidiService checks and encodes them and answers once the device
//! has taken them. There is no time to send AT - USB-MIDI 1.0 carries none - and no output scheduler.
//!
//! CHUNKS, NOT MESSAGES. A chunk carries at most three MIDI bytes: a complete short message, a raw byte, or a
//! FRAGMENT of a System Exclusive message - start, continuation, end, or start and end at once - under a
//! per-cable message number. A consumer treats a SysEx as incomplete until the fragment that ends it, and
//! discards it when an abort names it. Nothing assembles a whole SysEx: its cap, 64 kB with its delimiters,
//! is enforced by counting.
//!
//! ORDER AND TIME are `liber:event@1`'s: the endpoint's observation order across all its cables, never sorted,
//! and host receipt time only - USB MIDI 1.0 carries no device timestamp, and none is invented.
//!
//! UMP BESIDE MIDI 1.0. A `ump` endpoint - a USB MIDI 2.0 device's - carries Universal MIDI Packets: a message of one to
//! four 32-bit words, on one of sixteen GROUPS, and the endpoint lists the function blocks its groups belong to. A
//! receiver reads it as `ump` items, its SysEx7 and SysEx8 counted within the bounds a MIDI 1.0 SysEx is; a sender
//! sends UMP messages. AND EITHER SPEAKS TO EITHER: a receiver may ask for the other protocol, and a MIDI 1.0 endpoint
//! is then read as MIDI 1.0 in UMP, or a UMP endpoint as MIDI 1.0 chunks by the specification's translation - a cable
//! is a group, and a group a cable; a sender may send either on either the same way. Nothing else invents a group.

package liber:midi@1;

use liber:base@1.{error};
use liber:process@1.{task};
use liber:event@1.{event-source, event-header, event-end};

/// An endpoint as this service knows it: its publication, its index in it, and the service incarnation.
record midi-endpoint-id {
	slot:               u32,
	generation:         u32,
	binding-generation: u64,
	endpoint:           u32,
	incarnation:        u64,
}

enum midi-protocol {
	midi1 = 1,
	ump   = 2,
}

enum midi-direction {
	receive  = 1,
	transmit = 2,
}

/// Which way a function block's groups carry messages, from the DEVICE's side.
enum midi-block-direction {
	receives = 1,
	sends    = 2,
	both     = 3,
}

/// One function block of a UMP endpoint, as the device declares it.
record midi-block {
	id:              u8,
	@bound(32) name: string,
	first-group:     u8,
	groups:          u8,
	direction:       midi-block-direction,
	/// The MIDI protocol the block says it speaks, as the device numbers it.
	protocol:        u8,
}

record midi-endpoint {
	id:              midi-endpoint-id,
	@bound(64) name: string,
	protocol:        midi-protocol,
	direction:       midi-direction,
	/// Cables 0..cables-1 are this endpoint's - for a UMP endpoint, the groups its blocks cover; at most 16.
	cables:          u8,
	/// A receiver holds it now - or, on a transmit endpoint, a sender.
	receiving:       bool,
	/// A UMP endpoint's function blocks; none for a MIDI 1.0 one.
	@bound(8) blocks: list<midi-block>,
}

/// ONE UNIVERSAL MIDI PACKET MESSAGE: its words, as many as its first word's type says, and its group - absent for the
/// utility and stream messages, which have none.
record midi-ump {
	group:            option<u8>,
	@bound(4) words:  list<u32>,
}

enum midi-chunk-kind {
	/// A complete message: channel voice, system common, or realtime.
	short         = 1,
	sysex-start   = 2,
	sysex-continue = 3,
	sysex-end     = 4,
	/// A byte from the single-byte form that belongs to no message this decoder tracks.
	raw           = 5,
}

record midi-chunk {
	/// 0..15. There is no group: MIDI 1.0 has none, and none is fabricated.
	cable:              u8,
	kind:               midi-chunk-kind,
	@bound(3) bytes:    list<u8>,
	/// The per-cable SysEx message this fragment belongs to; absent for anything else.
	sysex-message:      option<u32>,
	/// This fragment starts, and this one ends, its message - both at once for a one-fragment SysEx.
	start:              bool,
	end:                bool,
}

enum midi-abort-reason {
	/// The message crossed 64 kB with its delimiters.
	cap          = 1,
	/// A continuation or an end that does not fit the message.
	malformed    = 2,
	/// A non-realtime status arrived inside it.
	interrupted  = 3,
	/// Two seconds passed with nothing more of it.
	inactivity   = 4,
	/// A new start arrived before its end.
	restarted    = 5,
	/// Its cable, or the whole endpoint, was reset.
	reset        = 6,
}

/// A SysEx that will never end: discard what was received of it.
record midi-abort {
	cable:   u8,
	message: u32,
	reason:  midi-abort-reason,
}

enum midi-fault-code {
	/// A packet batch whose length is not a whole number of four-byte packets.
	alignment = 1,
	/// A cable outside the endpoint's.
	cable     = 2,
	/// A reserved or unsupported code index.
	reserved  = 3,
	/// A status that does not match its code index, or a data byte with the top bit set.
	status    = 4,
	/// Padding that is not zero.
	padding   = 5,
	/// UMP words a batch ends inside a message of.
	truncated = 6,
}

/// A packet the decoder refused; `cable` is absent when the refusal could not be attributed to one, in which
/// case every cable's partial state was reset.
record midi-fault {
	cable: option<u8>,
	code:  midi-fault-code,
}

variant midi-item {
	chunk(midi-chunk),
	aborted(midi-abort),
	fault(midi-fault),
	/// A UMP message, to a receiver reading UMP. Its SysEx7 and SysEx8 parts are counted as a chunk's are, and an
	/// abort's `cable` is then the group.
	ump(midi-ump),
}

record midi-event {
	header: event-header,
	item:   midi-item,
}

/// What one read returns: events in order, and - once everything before it has been read - how the stream
/// ended.
record midi-batch {
	source:             event-source,
	@bound(64) events:  list<midi-event>,
	end:                option<event-end>,
}

record midi-receiver-status {
	source:       event-source,
	queued:       u16,
	queued-bytes: u32,
	end:          option<event-end>,
}

/// INVENTORY: the endpoints and what they are. `open` exists to say no precisely: receiving and sending each
/// need a grant, and a direction the endpoint does not have is invalid.
interface midi {
	@op(1) @bound(32) endpoints: func() -> result<list<midi-endpoint>, error>;
	@op(2) open: func(endpoint: midi-endpoint-id, direction: midi-direction, protocol: midi-protocol) -> result<unit, error>;
}

/// ONE RECEIVER, on the one endpoint this connection was minted for, for as long as its owner lives. Reads
/// PULL: nothing is pushed into a client that is not reading.
interface midi-input {
	@op(1) endpoint: func() -> result<midi-endpoint, error>;
	/// At most `max` events, waiting at most `wait-ms` for the first; after the last event of an ended stream,
	/// the end.
	@op(2) read:     func(max: u16, wait-ms: u32) -> result<midi-batch, error>;
	@op(3) status:   func() -> result<midi-receiver-status, error>;
	/// Stop receiving; the queued events are discarded and the slot freed.
	@op(4) stop:     func() -> result<unit, error>;
	/// READ THE OTHER PROTOCOL from here on: a MIDI 1.0 endpoint as MIDI 1.0 in UMP, or a UMP endpoint as MIDI 1.0
	/// chunks by the specification's translation - a group as a cable, MIDI 2.0 channel voice translated down, and a
	/// message with no MIDI 1.0 form not delivered. The endpoint's own protocol is the default.
	@op(5) protocol: func(protocol: midi-protocol) -> result<unit, error>;
}

/// ONE SENDER, on the one transmit endpoint this connection was minted for, for as long as its owner lives.
interface midi-output {
	@op(1) endpoint: func() -> result<midi-endpoint, error>;
	/// Send these chunks, in order, as one batch: complete short messages, and SysEx fragments - three bytes
	/// each but the one that ends its message. CHECKED WHOLE BEFORE ANY OF IT IS SENT, and answered once the
	/// device has taken all of it; a refused batch sends nothing and leaves every open message as it was.
	@op(2) send:     func(@bound(64) chunks: list<midi-chunk>) -> result<unit, error>;
	/// Stop sending; a message the sender left open stays unfinished, and the slot is freed.
	@op(3) stop:     func() -> result<unit, error>;
	/// Send these UMP messages, in order, as one batch - checked whole as `send` is. On a MIDI 1.0 endpoint they go as
	/// MIDI 1.0 by the translation, a group as a cable, and a message with no MIDI 1.0 form refuses the batch.
	@op(4) send-ump: func(@bound(64) messages: list<midi-ump>) -> result<unit, error>;
}

record midi-grant {
	connection: handle<channel>,
	source:     event-source,
}

/// THE MINTING ENDPOINT, PermissionManager's alone. The alias names a MIDI device the service's configuration
/// binds to provider metadata; it resolves to exactly one current publication, and `endpoint` to one of its
/// receive endpoints, or the mint fails. Minting starts the receiver; one receiver per endpoint.
interface midi-admin {
	@op(1) mint:   func(@bound(32) alias: string, endpoint: u32, owner: handle<task>) -> result<midi-grant, error>;
	/// End every receiver on one endpoint; answers how many.
	@op(2) revoke: func(endpoint: midi-endpoint-id) -> result<u32, error>;
	/// The same for a SENDER on one transmit endpoint: one per endpoint, ended by close, revocation, owner death
	/// or device replacement.
	@op(3) mint-output: func(@bound(32) alias: string, endpoint: u32, owner: handle<task>) -> result<midi-grant, error>;
}
