//! LiberSystem MIDI devices - the provider contract a `midi` publication serves to MidiService.
//!
//! A PROVIDER MOVES PACKETS; THE SERVICE DECODES AND ENCODES. The USB MIDI class module, and the in-guest
//! fixture before it, deliver USB-MIDI 1.0 event packets exactly as the transport completed them - at most 64
//! to a batch, with the host time the completion became available - and MidiService decodes them with the
//! driver library's staged decoder. The other way, MidiService encodes with the same library and a provider
//! puts the packets on the wire as they are. No client ever sees or writes a raw packet.
//!
//! AN ENDPOINT SAYS WHICH PACKETS IT CARRIES. A `midi1` endpoint's are USB-MIDI 1.0 event packets; a `ump`
//! endpoint's are Universal MIDI Packet WORDS - each four bytes, little-endian, a message one to four of them - which
//! is what a USB MIDI 2.0 device's alternate setting carries, and the endpoint lists the function blocks its groups
//! belong to. A device's two faces are alternates of one interface, so a provider runs one face at a time.

package liber:midi-device@1;

use liber:base@1.{error};

record midi-bounds {
	version:     u32,
	/// Packets in one batch; at most 64.
	max-packets: u16,
}

record midi-open {
	connection-generation: u64,
	bounds:                midi-bounds,
}

/// Which way an endpoint's packets go: from the device, or to it.
enum midi-device-direction {
	receive  = 1,
	transmit = 2,
}

/// The packets an endpoint carries.
enum midi-device-protocol {
	midi1 = 1,
	ump   = 2,
}

record midi-device-endpoint {
	index:           u32,
	@bound(64) name: string,
	/// The cables of a `midi1` endpoint; the groups a `ump` endpoint's blocks cover - at most sixteen either way.
	cables:          u8,
	direction:       midi-device-direction,
	protocol:        midi-device-protocol,
}

/// Which way a function block's groups carry messages, from the DEVICE's side.
enum midi-device-block-direction {
	receives = 1,
	sends    = 2,
	both     = 3,
}

/// ONE FUNCTION BLOCK of a UMP endpoint, as the device declares it: which groups belong together, which way they go,
/// its name and the MIDI protocol it says it speaks (`bMIDIProtocol`).
record midi-device-block {
	id:              u8,
	@bound(32) name: string,
	first-group:     u8,
	groups:          u8,
	direction:       midi-device-block-direction,
	protocol:        u8,
}

/// One transport completion's packets, four bytes each, in the order they arrived.
record midi-packet-batch {
	endpoint:            u32,
	receiver-generation: u64,
	received-ns:         u64,
	@bound(256) packets: list<u8>,
}

/// Input the provider could not deliver.
record midi-input-lost {
	endpoint:            u32,
	receiver-generation: u64,
}

variant midi-device-event {
	batch(midi-packet-batch),
	lost(midi-input-lost),
}

/// THE PROVIDER CONTRACT a `midi` publication serves - to MidiService alone.
interface midi-device {
	@op(1) open:      func(version: u32) -> result<midi-open, error>;
	@op(2) @bound(8) endpoints: func() -> result<list<midi-device-endpoint>, error>;
	@op(3) start:     func(endpoint: u32, receiver-generation: u64) -> result<unit, error>;
	@op(4) stop:      func(endpoint: u32, receiver-generation: u64) -> result<unit, error>;
	@op(5) events:    func() -> stream<midi-device-event>;
	/// Put at most 64 USB-MIDI 1.0 event packets on a TRANSMIT endpoint, in order. ANSWERED WHEN THE TRANSPORT
	/// HAS TAKEN ALL OF THEM, so a caller that waits for the answer is paced by the device and nothing queues
	/// behind it; refused on a receive endpoint, for a cable the endpoint does not carry, and for a batch that
	/// is not a whole number of packets.
	@op(6) send:      func(endpoint: u32, @bound(256) packets: list<u8>) -> result<unit, error>;
	/// A `ump` endpoint's function blocks; none for a `midi1` endpoint.
	@op(7) @bound(8) blocks: func(endpoint: u32) -> result<list<midi-device-block>, error>;
}

// ------------------------------------------------------------------ development only

record midi-fixture-stats {
	batches:  u32,
	packets:  u32,
	receiving: u8,
	/// Packets taken on the transmit endpoint - each of them played back on receive endpoint 0.
	sent:     u32,
}

/// The in-guest MIDI fixture's control endpoint. DEVELOPMENT ONLY: it exists on a development fixture bound
/// to a QEMU test device, reached through PermissionManager in a development build for a probe whose policy
/// row grants `fixture-control`.
interface midi-fixture {
	/// Deliver these packets as one batch on an endpoint that is receiving.
	@op(1) inject:    func(endpoint: u32, @bound(256) packets: list<u8>) -> result<unit, error>;
	/// Deliver `batches` batches of 64 note-on packets as fast as the service takes them.
	@op(2) flood:     func(endpoint: u32, batches: u32) -> result<unit, error>;
	/// Report input on an endpoint as lost.
	@op(3) lose:      func(endpoint: u32) -> result<unit, error>;
	@op(4) withdraw:  func() -> result<unit, error>;
	@op(5) republish: func() -> result<unit, error>;
	@op(6) stats:     func() -> result<midi-fixture-stats, error>;
}
