//! LiberSystem device package - device and USB enumeration services.

package liber:device@1;

use liber:base@1.{error};

/// The class of a discovered device, mirroring the kernel's device type codes.
enum device-type {
	unknown = 0,
	net     = 1,
	block   = 2,
	console = 3,
	usb     = 4,
}

/// One discovered device: its kernel-table index, class, and the size of the MMIO
/// window its driver maps.
record device-entry {
	index:    u32,
	type:     device-type,
	mmio-len: u64,
}

/// Where a device binding is. One vocabulary, defined once: `lsdev`, the System Graph and the boot
/// log render the same enum rather than each deriving a state of its own - which is what made the
/// graph's unconditional `running` possible to write.
enum binding-state {
	unbound            = 0,
	dependency-pending = 1,
	binding            = 2,
	online             = 3,
	stopping           = 4,
	backoff            = 5,
	failed             = 6,
	quarantined        = 7,
	disabled           = 8,
}

/// Why a binding is not up. A STATE and a CAUSE are not alternatives - "quarantined" and "hung" are
/// two halves of one answer - so a record carries both, and `none` is what a binding that has not
/// failed says rather than an absent field every reader has to guess about.
enum failure-cause {
	none                    = 0,
	driver-missing          = 1,
	protocol-mismatch       = 2,
	claim-refused           = 3,
	iommu-required          = 4,
	resource-exhausted      = 5,
	spawn-failed            = 6,
	handshake-timeout       = 7,
	driver-exited           = 8,
	driver-reported-failure = 9,
	teardown-unconfirmed    = 10,
	hung                    = 11,
}

/// One device node's binding, as DeviceManager holds it.
///
/// The node is stable from the boot scan onward, so a record exists for a device nothing binds -
/// which is a fact about the machine and not an absence.
record binding-record {
	bus:         u32,
	dev:         u32,
	func:        u32,
	/// The claim generation of the current binding, or of the last one that ended. 0 for a node
	/// that has never been claimed.
	generation:  u64,
	state:       binding-state,
	cause:       failure-cause,
	/// Automatic attempts spent on the current incident.
	attempts:    u32,
	/// The driver artifact chosen for it, or empty where nothing matched.
	artifact:    string,
	/// WHICH of that entry's match rules chose it. An entry may declare several - a kind and a
	/// pinned address, say - and "virtio_console bound it" does not say which of them applied.
	/// `system-manifest` refuses two entries whose rules overlap at one priority, so the artifact
	/// and this index together name the rule uniquely.
	rule:        u32,
	/// How many providers this binding has published.
	providers:   u32,
	/// How many resources the bind granted it - the MMIO window, an interrupt, and whatever its
	/// registry entry asked for.
	resources:   u32,
}

/// The Device service contract: enumerate the devices the kernel discovered on the
/// bus, or look one up by its table index. Typed enumeration over the kernel device
/// table (the same table DeviceManager binds drivers to).
interface device {
	@op(1) list: func() -> result<list<device-entry>, error>;
	@op(2) get:  func(index: u32) -> result<device-entry, error>;
	/// The binding of every device node, FORWARDED VERBATIM from DeviceManager - which is the only
	/// process that holds them. Not derived here: a second rendering is how one surface comes to
	/// report a constant where a state belongs, and `lsdev` and the System Graph must not be able
	/// to disagree about what a device is doing.
	@op(3) bindings: func() -> result<list<binding-record>, error>;
}

/// What a driver publishes for others to use. The set is closed: a kind this system
/// does not have is a manifest that fails to parse, not a requirement nothing ever
/// satisfies.
enum provider-kind {
	block         = 1,
	net           = 2,
	display       = 3,
	audio         = 4,
	input         = 5,
	usb-bus       = 6,
	pointer       = 7,
	console-bytes = 8,
}

/// One published provider, named by the identity DeviceManager assigned it - never by
/// one a driver chose. The binding is its publisher's: the PCI function's bus/device/
/// function and the claim generation of the binding that published it, so a provider
/// from a binding that is over is distinguishable from its replacement. `slot` and
/// `provider-generation` are the manager's own, and together they make a reused slot
/// unmistakable for the provider that left it.
record provider-info {
	kind:                provider-kind,
	bus:                 u32,
	dev:                 u32,
	func:                u32,
	binding-generation:  u64,
	slot:                u32,
	provider-generation: u32,
}

/// The provider catalogue, served by DeviceManager - the only process that holds it.
///
/// `subscribe` answers with everything of that kind published RIGHT NOW and continues
/// as the live stream. One operation, because two would have a window between them:
/// a provider added after the read and before the registration would be in neither,
/// and that is the same race as a service started later seeing nothing.
interface provider-catalogue {
	@op(1) subscribe: func(kind: provider-kind) -> stream<provider-info>;
	/// Every device node's binding, in one read. `lsdev` and the System Graph both ask this rather
	/// than each deriving a state - the log is not a third rendering to compare against, because it
	/// is a history of transitions and this is a moment.
	@op(2) bindings:  func() -> list<binding-record>;
}

/// One enumerated USB device, as the xHCI driver addressed it: the root port it hangs
/// off (a device behind a hub reports the hub's root port), its speed, the vendor and
/// product ids from its device descriptor, its class code, and the role the driver
/// bound it to ("hub", "keyboard", "storage", or "device" for an unclaimed one).
record usb-device {
	port:    u32,
	speed:   string,
	vendor:  u32,
	product: u32,
	class:   u32,
	type:    string,
}

/// The USB bus contract, served by the xHCI driver itself (the owner of the bus
/// state): enumerate the devices it addressed, live - hot-plugged and detached
/// devices come and go from the list. The `lsusb` inventory reads this.
interface usb {
	@op(1) list: func() -> result<list<usb-device>, error>;
}
