//! LiberSystem Bluetooth - what a client may ask of the host stack, in three separate authorities.
//!
//! THREE INTERFACES AND NOT THREE METHODS ON ONE, because the difference between them is who may
//! hold them rather than what they do. A component that may LIST the radios on a machine must not
//! be able to power one; a component that may pair must not be able to read a link key; and the
//! input service, which is the one consumer of what pairing produces, must be able to do neither.
//!
//! NOTHING HERE CARRIES A KEY OR A RAW HCI PACKET. The keys live in a backend this service reaches
//! over a private capability and the packets live under the transport; a client of any interface
//! below sees typed state and typed outcomes, and a component that could see either could be the
//! stack itself.

package liber:bluetooth@1;

use liber:base@1.{error};
use liber:process@1.{task};

/// Which kind a peer address is.
///
/// A RESOLVABLE PRIVATE ADDRESS - one a device rotates for privacy - is resolved with the identity key the
/// peer gave at bonding, and a bonded peer is always named by its IDENTITY address; `resolvable` names one
/// seen before it resolved, or one no bond resolves.
enum peer-kind {
	/// An LE address from the device's own assigned block.
	public        = 1,
	/// An LE random address the device does not rotate.
	random-static = 2,
	/// A BR/EDR device address.
	bredr         = 3,
	/// An LE resolvable private address no bond resolves.
	resolvable    = 4,
}

/// Which radio a device was found on or is bonded over.
enum radio {
	classic = 1,
	le      = 2,
}

/// A peer's address, most significant byte first - the order the specification's own sample data is
/// printed in, and the order the key derivations take.
record peer-address {
	kind:              peer-kind,
	@bound(6) bytes:   list<u8>,
}

/// What a controller is and what it can do.
record controller-info {
	/// Its own identity address.
	address:            peer-address,
	/// Whether the radio is on.
	powered:            bool,
	/// WHETHER IT HAS THE P-256 COMMANDS LE SECURE CONNECTIONS NEEDS. The curve half of pairing is
	/// the controller's here, so a controller without them cannot pair at all under this service -
	/// and that is reported as a fact about the machine rather than discovered as a pairing that
	/// fails halfway.
	secure-connections: bool,
	/// The session this controller is in. A reset advances it, and everything a client held from
	/// the previous one is gone.
	epoch:              u32,
	/// Whether it has a BR/EDR radio as well as LE.
	classic:            bool,
	/// The inbound policy's state now: page scan, inquiry scan, and whether a prompt watcher makes
	/// it pairable.
	connectable:        bool,
	discoverable:       bool,
	pairable:           bool,
}

/// A 16-bit service class UUID, as an extended inquiry response or an advertisement names it. A record and not a
/// bare `u16` so that the list of them is this package's own type: a list of a primitive is a growth routine
/// every package shares, and which package provides it differs per target.
record service-class {
	uuid: u16,
}

/// One device a scan found.
record scan-result {
	address:           peer-address,
	/// The name it advertised, empty when it advertised none. A NAME IS NOT AN IDENTITY: it is
	/// whatever the device chose to broadcast, any device may broadcast any name, and nothing in
	/// this stack decides anything from it.
	@bound(48) name:   string,
	/// The received signal strength, in dBm as the controller reported it.
	rssi:              i32,
	/// Whether it advertised the human-interface service. A hint for an operator choosing from a
	/// list, and not a claim that this stack can drive it.
	human-interface:   bool,
	/// The radio it was found on.
	radio:             radio,
	/// A classic device's class of device, zero on LE.
	class-of-device:   u32,
	/// The 16-bit service class UUIDs its extended inquiry response or advertisement named.
	@bound(16) services: list<service-class>,
}

/// How far a pairing attempt has got.
enum pairing-state {
	/// Nothing is in flight.
	idle       = 1,
	/// Connecting to the peer.
	connecting = 2,
	/// Exchanging keys.
	pairing    = 3,
	/// Bonded and durably stored. A pairing is not reported as bonded before the record is
	/// committed: a bond that exists only in memory is one a reboot silently removes, and a person
	/// told they had paired would find the device asking again.
	bonded     = 4,
	/// It ended without bonding. `outcome` says why.
	failed     = 5,
}

/// WHAT THE ENCRYPTION ON A LINK IS WORTH, reported rather than implied.
///
/// This slice implements the Just Works association model, which buys encryption against a listener
/// and NOT authentication against a radio that answered first. A stack that reported one number for
/// both would be telling an operator that a device is the device they pressed a button on, which
/// nothing here establishes.
enum security-level {
	/// No encryption.
	none                        = 1,
	/// Encrypted, and the peer is NOT authenticated. This is what Just Works produces.
	encrypted-unauthenticated   = 2,
	/// Encrypted and authenticated. No association model in this slice reaches it, and it is named
	/// so that a client reads the level rather than assuming the one it was given.
	encrypted-authenticated     = 3,
}

/// THE KEY AGREEMENT a bond was made with, lowest first within each radio.
enum key-agreement {
	/// BR/EDR legacy pairing with a PIN, only ever when the operator asked for it.
	legacy             = 1,
	/// LE legacy pairing, the same.
	le-legacy          = 2,
	/// BR/EDR Secure Simple Pairing on P-192.
	p192               = 3,
	/// P-256 Secure Connections, either radio.
	secure-connections = 4,
}

/// A BOND'S LEVEL ON TWO AXES - the key agreement and whether a person authenticated it - and a bond is
/// never replaced by one lower on either.
record bond-level {
	agreement:     key-agreement,
	authenticated: bool,
}

/// A profile a peer may be trusted for: what admits an inbound connection for it, and what an
/// application grant for SPP or GATT is checked against.
enum profile {
	input = 1,
	audio = 2,
	voice = 3,
	pan   = 4,
	spp   = 5,
	gatt  = 6,
}

/// WHAT A PERSON IS ASKED during a pairing.
enum prompt-question {
	/// Do the six digits match the peer's? `value` is them.
	compare       = 1,
	/// Type `value` on the peer.
	show-passkey  = 2,
	/// Type the six digits the peer shows.
	enter-passkey = 3,
	/// Type the peer's PIN: legacy pairing, which the operator asked for.
	enter-pin     = 4,
	/// May this peer pair? An incoming pairing with no number to compare.
	consent       = 5,
}

/// ONE PROMPT the service originates on the operator authority: answered by `answer` before its deadline,
/// after which the service answers no itself.
record pairing-prompt {
	id:                u32,
	controller:        u32,
	peer:              peer-address,
	radio:             radio,
	question:          prompt-question,
	/// The six digits to compare or show; zero otherwise.
	value:             u32,
	/// Keypress notifications the peer sent while a passkey is typed on it.
	keypresses:        u8,
	/// How long is left, in milliseconds, when the prompt was sent.
	deadline-ms:       u32,
	@bound(48) name:   string,
}

/// What a person answered.
variant prompt-reply {
	yes,
	no,
	passkey(u32),
	pin(list<u8>),
}

/// One device as `btctl` lists it: both radios in one list.
record device-status {
	address:            peer-address,
	radio:              radio,
	@bound(48) name:    string,
	@bound(48) alias:   string,
	bonded:             bool,
	connected:          bool,
	level:              option<bond-level>,
	@bound(8) trusted:  list<profile>,
	/// The profiles connected to it now.
	@bound(8) connected-profiles: list<profile>,
	/// Its battery in percent, where it reports one.
	battery:            option<u8>,
}

/// What a pairing attempt came to.
record pairing-progress {
	state:    pairing-state,
	/// What the link is worth, once there is one.
	security: security-level,
	/// The peer this is about.
	address:  peer-address,
}

/// One bonded peer, as an operator sees it. NO KEY MATERIAL: a client of the operator interface may
/// forget a bond and may not read one.
record bonded-peer {
	address:           peer-address,
	@bound(48) name:   string,
	/// Whether this peer's input is currently an input source.
	enabled:           bool,
	security:          security-level,
	radio:             radio,
	level:             bond-level,
	@bound(8) trusted: list<profile>,
	@bound(48) alias:  string,
}

/// A scan's own identity, so that a cancellation names the scan it cancels rather than whichever one
/// happens to be running.
record scan-handle {
	id: u32,
}

/// THE READ AUTHORITY: what is here, and nothing that changes it.
///
/// A component holding this may enumerate controllers and look for devices. It may not power a
/// radio, pair, forget a bond or make a peer an input source - those are the operator's, and they
/// are on a different interface for that reason rather than being checked by a flag.
interface bluetooth {
	/// The controllers this machine has.
	@op(1) controllers: func() -> result<list<controller-info>, error>;
	/// Start a scan. `deadline-ms` is the caller's own limit and is CAPPED rather than believed: a
	/// scan is a radio running and a client asking for an hour of it is a client deciding how the
	/// machine behaves. At most 64 deduplicated results are reported and the scan ends by itself at
	/// the deadline, whichever comes first.
	@op(2) scan:        func(controller: u32, deadline-ms: u32) -> result<scan-handle, error>;
	/// The results so far, and whether the scan has finished. A scan that ended - at its deadline,
	/// at the result cap, or because it was cancelled - says so here, so a client learns of the end
	/// rather than waiting for one more result that will never come.
	@op(3) results:     func(scan: scan-handle) -> result<list<scan-result>, error>;
	/// Whether that scan is still running.
	@op(4) scanning:    func(scan: scan-handle) -> result<bool, error>;
	/// Stop a scan now. EXPLICIT, because a scan that only ever ended at its deadline would keep a
	/// radio busy for the rest of a caller's ten seconds after it had found what it wanted.
	@op(5) cancel:      func(scan: scan-handle) -> result<unit, error>;
}

/// THE OPERATOR AUTHORITY: the verbs that change what the machine is doing.
///
/// Granted to one explicitly trusted component through the manifest's own grant path, and to nothing
/// else. THIS IS AN ADMINISTRATIVE AUTHORIZATION AND NOT A CLAIM ABOUT THE PHYSICAL DEVICE: that a
/// person is allowed to pair says nothing about whether the radio that answered is the mouse on the
/// desk, and the security level every answer here carries is what says so.
interface bluetooth-operator {
	/// Turn a controller's radio on or off. The platform's own allow or deny setting is enforced
	/// here and a refusal says so; this service invents no radio policy of its own.
	@op(1) power:    func(controller: u32, on: bool) -> result<unit, error>;
	/// Begin pairing with a peer. ONE ATTEMPT PER CONTROLLER IS LIVE, and a second while one is in
	/// flight is refused rather than queued - a queued pairing is one an operator has stopped
	/// watching. The attempt is capped at sixty seconds whatever the peer does.
	@op(2) pair:     func(controller: u32, peer: peer-address) -> result<unit, error>;
	/// How the live attempt is going.
	@op(3) progress: func(controller: u32) -> result<pairing-progress, error>;
	/// Abandon the live attempt.
	@op(4) cancel:   func(controller: u32) -> result<unit, error>;
	/// The peers this machine is bonded to.
	@op(5) bonded:   func(controller: u32) -> result<list<bonded-peer>, error>;
	/// Delete a bond. DURABLY, AND BEFORE THIS ANSWERS: a forget that reported success and left the
	/// record on the volume is a device an operator believes is gone and which reconnects after a
	/// reboot. The live link is terminated with it.
	@op(6) forget:   func(controller: u32, peer: peer-address) -> result<unit, error>;
	/// Make a bonded peer an input source, or stop it being one. Disabling closes whatever channel
	/// the input service holds for it. The same as trusting it for input.
	@op(7) enable:   func(controller: u32, peer: peer-address, on: bool) -> result<unit, error>;
	/// THE PROMPT WATCHER: a stream of this controller's pairing prompts. While one is open the controller
	/// is pairable and declares the IO capabilities a person can answer; one watcher per controller, a
	/// second refused.
	@op(8) prompts:  func(controller: u32) -> result<stream<pairing-prompt>, error>;
	/// Answer a prompt. A reply that does not fit the question, or comes after the deadline, is refused.
	@op(9) answer:   func(controller: u32, prompt: u32, reply: prompt-reply) -> result<unit, error>;
	/// Make the classic radio discoverable for at most 180 seconds; zero ends it.
	@op(10) discoverable: func(controller: u32, seconds: u32) -> result<unit, error>;
	/// Trust a bonded peer for a profile, or stop trusting it.
	@op(11) trust:   func(controller: u32, peer: peer-address, profile: profile, on: bool) -> result<unit, error>;
	/// The operator's name for a bonded peer: what an application grant names it by. Empty clears it.
	@op(12) alias:   func(controller: u32, peer: peer-address, @bound(32) alias: string) -> result<unit, error>;
	/// Every device this controller knows - bonded, connected or found - on both radios.
	@op(13) devices: func(controller: u32) -> result<list<device-status>, error>;
	/// Connect a bonded peer's profile, or disconnect it.
	@op(14) connect:    func(controller: u32, peer: peer-address, profile: profile) -> result<unit, error>;
	@op(15) disconnect: func(controller: u32, peer: peer-address, profile: profile) -> result<unit, error>;
	/// Pair with legacy PIN entry: only for a device that cannot do better, and never over a better bond.
	@op(16) pair-legacy: func(controller: u32, peer: peer-address) -> result<unit, error>;
	/// THE REMOTE CONTROL, toward a phone playing to this system: a button pressed and let go over AVRCP.
	@op(17) media:       func(controller: u32, peer: peer-address, command: media-command) -> result<unit, error>;
	/// PUSH ONE OBJECT to a bonded peer over OBEX Object Push - on L2CAP where the peer's record offers it, on RFCOMM
	/// otherwise - named `name`, of `length` bytes where the caller knows it. The object's bytes go on the returned
	/// `object-push`: THIS SERVICE HOLDS NO STORAGE AUTHORITY, and reads no file - `btctl send` forwards the stream the
	/// shell's input redirection opened.
	@op(18) send:        func(controller: u32, peer: peer-address, @bound(256) name: string, length: option<u64>) -> result<handle<channel>, error>;
	/// RECEIVE THE ONE OBJECT the bonded `peer` pushes while this waits - at most `max-bytes` of it, for at most 180
	/// seconds or until the stream is closed. While it waits the peer's page and its Object Push channel are admitted,
	/// and nobody else's; an object that declares more than `max-bytes` is refused before a byte of it is taken, and
	/// one that passes it while arriving is aborted. CONSENTED BY THE CALL: no prompt is raised. One receiver per
	/// controller.
	@op(19) receive:     func(controller: u32, peer: peer-address, max-bytes: u64) -> result<stream<received-object>, error>;
	/// TETHER TO A BONDED PEER'S NETWORK ACCESS POINT as a PAN user, the link offered to NetworkService - which may make
	/// it the uplink in place of a selected one only where `replace-uplink` says so; otherwise it is held, unselected,
	/// while another is selected. `connect` with `pan` is this without `replace-uplink`.
	@op(20) connect-pan: func(controller: u32, peer: peer-address, replace-uplink: bool) -> result<unit, error>;
	/// LOOK FOR LE AUDIO BROADCASTS for at most `seconds` (30 at most): their announcements gathered for `broadcasts`.
	@op(21) broadcast-scan: func(controller: u32, seconds: u32) -> result<unit, error>;
	/// The broadcasts heard by the last `broadcast-scan`, so far.
	@op(22) broadcasts:     func(controller: u32) -> result<list<broadcast-source>, error>;
	/// PLAY ONE: its periodic train joined, its BASE read, its BIG synchronised - with `code` where it is encrypted,
	/// empty where it is not - and its streams offered to AudioService as a route to the default output, as a phone's
	/// A2DP stream is. One broadcast at a time; a second replaces the first.
	@op(23) broadcast-play: func(controller: u32, broadcast-id: u32, @bound(16) code: list<u8>) -> result<unit, error>;
	/// Stop the broadcast being played.
	@op(24) broadcast-stop: func(controller: u32) -> result<unit, error>;
}

/// An LE Audio broadcast heard: its Broadcast ID, its name as the source gave it, and the source's address and set.
record broadcast-source {
	broadcast-id: u32,
	@bound(32) name: string,
	address:      peer-address,
	sid:          u8,
}

/// What a receiver hears of the one object a peer pushes.
enum received-kind {
	/// The object begins: the peer's name for it, its type and the length it declared - the peer's words, never a path.
	offered   = 1,
	/// Its next bytes.
	data      = 2,
	/// It arrived whole.
	complete  = 3,
	/// It did not: refused for its size, aborted by the peer, or its link lost. `received` says how much came.
	failed    = 4,
	/// Nothing was pushed within the receiver's time.
	timed-out = 5,
}

record received-object {
	kind:                   received-kind,
	@bound(256) name:       string,
	@bound(64) object-type: string,
	declared:               option<u64>,
	received:               u64,
	@bound(1024) bytes:     list<u8>,
}

/// AN OBJECT BEING PUSHED, from `bluetooth-operator.send`: its bytes, then its end.
interface object-push {
	/// The object's next bytes, and how many were taken: `again` while the push holds as much as it may and the peer
	/// has not taken it, `closed` once the push is over.
	@op(1) write:  func(@bound(1024) data: list<u8>) -> result<u64, error>;
	/// The object's end. Answered when the peer has it - with the bytes it took - or with why it does not: `denied`
	/// for a peer that refused it, `not-found` for one that offers no Object Push, `timed-out` for one that never
	/// answered, `closed` for a link lost.
	@op(2) finish: func() -> result<u64, error>;
	/// Abandon it.
	@op(3) abort:  func() -> result<unit, error>;
}

/// A button the operator presses on a phone that plays to this system.
enum media-command {
	play     = 1,
	pause    = 2,
	next     = 3,
	previous = 4,
}

/// One pointer report, as this stack hands it up.
///
/// ALREADY DECODED AND NOT A HID REPORT. What crosses this channel is movement and buttons, so the
/// consumer needs no report parser and no knowledge of boot protocol - which is what keeps the one
/// consumer of this from having to become a second HID implementation.
record mouse-report {
	/// Movement since the last report, signed.
	dx:      i32,
	dy:      i32,
	/// Wheel ticks since the last report, signed.
	wheel:   i32,
	/// The three defined buttons, as bits: left, right, middle.
	buttons: u8,
}

/// A key going down or up, with its usage page. THE PAGE TRAVELS WITH IT: a keyboard's own keys are the
/// keyboard page's, and its media, volume and launcher keys the consumer page's, and the two are never folded
/// into one number a consumer must take apart.
record key-transition {
	page:  u16,
	usage: u16,
	down:  bool,
}

/// A gamepad frame on the production gamepad wire - its arrival with its shape, a state, or its departure -
/// exactly as a gamepad driver sends one, so the gamepad set takes a Bluetooth gamepad as one more source.
record gamepad-frame {
	@bound(160) bytes: list<u8>,
}

/// One decoded report from a peer trusted for input. DECODED AND NEVER A HID REPORT: the consumer needs no
/// report parser, which is what keeps it from having to become a second HID implementation.
variant input-report {
	pointer(mouse-report),
	key(key-transition),
	gamepad(gamepad-frame),
}

/// A peer this machine's operator has trusted for input, as the input service learns of it: the
/// controller it is bonded on and its address, and nothing else - no key, no name, no security record.
record enabled-peer {
	controller: u32,
	peer:       peer-address,
}

/// THE PROFILE AUTHORITY: one verb, over peers an operator has already trusted for input.
///
/// Held by the input service and by nothing else. It cannot scan, cannot pair, cannot enumerate
/// bonds and cannot reach a peer the operator has not trusted - so the component that consumes
/// input has no authority over the radio that produces it.
interface bluetooth-profile {
	/// A bounded stream of decoded reports from one peer trusted for input, on either radio: pointer motion,
	/// key transitions with their page, and gamepad frames. Refused for a peer that is not bonded or not
	/// trusted for input. The stream ends when the trust is withdrawn, when the link is lost, or when the
	/// controller's session ends - and a consumer learns of all three the same way.
	@op(1) open-input: func(controller: u32, peer: peer-address) -> result<stream<input-report>, error>;
	/// The peers `open-input` would accept right now: bonded and trusted for input, on every controller. WITHOUT
	/// IT THE ONE CONSUMER OF THIS INTERFACE COULD NOT FIND WHAT IT IS ALLOWED TO OPEN, and handing it the
	/// operator's bonded list would hand it the verbs that come with it.
	@op(2) enabled: func() -> result<list<enabled-peer>, error>;
}

/// A primary service on a peer, as an application's GATT grant sees it: its 16-bit class and its handle range.
record gatt-service {
	uuid:  u16,
	start: u16,
	end:   u16,
}

/// A characteristic: its value's handle, its class and its declaration's properties.
record gatt-characteristic {
	handle:     u16,
	uuid:       u16,
	properties: u8,
}

/// A notification's or an indication's value, with the characteristic it came from.
record gatt-value {
	handle: u16,
	@bound(244) value: list<u8>,
}

/// AN APPLICATION'S GATT CLIENT, minted per launch by PermissionManager for one component, one bonded peer the
/// operator gave an alias and trusted for GATT, and a set of services. IT REACHES NOTHING OUTSIDE THOSE SERVICES - and
/// never a service the stack drives itself: HID, GAP, GATT and the LE Audio services - and it ends with the launch.
/// While the peer is not connected every operation answers `closed`.
interface bluetooth-gatt {
	/// The granted services the peer has.
	@op(1) services:        func() -> result<list<gatt-service>, error>;
	/// The characteristics of the granted service beginning at `start`.
	@op(2) characteristics: func(start: u16) -> result<list<gatt-characteristic>, error>;
	@op(3) read:            func(handle: u16) -> result<list<u8>, error>;
	/// A write with a response.
	@op(4) write:           func(handle: u16, @bound(244) value: list<u8>) -> result<unit, error>;
	/// The characteristic's notifications, turned on for as long as the stream is held.
	@op(5) subscribe:       func(handle: u16) -> result<stream<gatt-value>, error>;
}

/// A piece of what a serial port's peer sent, in the order it sent it.
record serial-bytes {
	@bound(1024) bytes: list<u8>,
}

/// AN APPLICATION'S SERIAL PORT, minted per launch by PermissionManager for one component and one bonded BR/EDR peer
/// the operator gave an alias and trusted for the serial port profile: a byte stream over RFCOMM and nothing above
/// it. NOT A CONSOLE - `console-bytes` is a device's kind, and its one consumer is the development agent. It ends
/// with the launch, and the channel it opened closes with it.
interface bluetooth-serial {
	/// Connect the port: the peer paged where it has no link, its record searched for the serial port and the RFCOMM
	/// channel the record names opened. Answered when the channel is open - at once where it is - or with why it is
	/// not: `not-found` for a peer that offers no serial port, `timed-out` for one that never answered.
	@op(1) connect: func() -> result<unit, error>;
	/// Bytes to the peer, and how many were taken: as many as the channel's queue holds past the peer's credits.
	/// `again` when it holds nothing more - the peer's credits are the backpressure - and `closed` while the channel
	/// is not open.
	@op(2) write:   func(@bound(1024) data: list<u8>) -> result<u32, error>;
	/// What the peer sends, as it arrives - one subscription. A reader that falls behind holds the peer, its credits
	/// not given back, rather than losing bytes. The stream ends when the channel closes.
	@op(3) read:    func() -> result<stream<serial-bytes>, error>;
	/// Close the channel. The grant stays for its launch and may connect again.
	@op(4) close:   func() -> result<unit, error>;
}

/// THE MINTING ROOT PermissionManager holds, and nothing else: application grants, each for one component's launch.
interface bluetooth-admin {
	/// A GATT client for `owner`'s launch, on the bonded peer the operator named `alias` - refused unless that peer is
	/// trusted for GATT - and for these services alone.
	@op(1) mint-gatt: func(@bound(32) alias: string, @bound(8) services: list<service-class>, owner: handle<task>) -> result<handle<channel>, error>;
	/// A serial port for `owner`'s launch, on the bonded BR/EDR peer the operator named `alias` - refused unless that
	/// peer is trusted for the serial port profile. Minting connects nothing.
	@op(2) mint-serial: func(@bound(32) alias: string, owner: handle<task>) -> result<handle<channel>, error>;
}

/// WHAT A BOND IS, on the private wire between this service and the store that keeps it.
///
/// THE KEY IS IN HERE AND THIS RECORD GOES NOWHERE ELSE. No client interface above carries one, and
/// the capability that reaches this one is granted to the Bluetooth service alone.
record bond-record {
	/// Which record format this is. A version this store does not know is unavailable rather than
	/// read: a record read under the wrong layout is a key applied to the wrong link.
	version:          u32,
	/// The controller whose bond this is. A record whose controller is not the one asking is
	/// refused: one machine's key is not another's, and a store that answered by peer address alone
	/// would hand a second controller the first one's link.
	local:            peer-address,
	peer:             peer-address,
	/// The long-term key.
	@bound(16) key:   list<u8>,
	/// What the link this key came from was worth. Stored rather than recomputed, because the
	/// association model that produced it is not derivable from the key.
	security:         security-level,
	@bound(48) name:  string,
	/// Whether the operator has made this peer an input source.
	enabled:          bool,
	/// The radio the bond is over; a peer bonded over both through a derived key has a record for each.
	radio:            radio,
	/// The BR/EDR link key and its type, as Link Key Notification gave them; empty on LE.
	@bound(16) link-key: list<u8>,
	link-key-type:    u8,
	/// The level, on both axes.
	level:            bond-level,
	@bound(8) trusted: list<profile>,
	@bound(48) alias: string,
	/// The LE peer's identity resolving key, where it gave one; empty otherwise.
	@bound(16) irk:   list<u8>,
	/// An LE legacy key's EDIV and Rand, which name it when a link is encrypted with it; zero and empty for
	/// Secure Connections.
	ediv:             u16,
	@bound(8) rand:   list<u8>,
}

/// THE BOND STORE'S PRIVATE INTERFACE. One holder, and it is not a client of anything above.
interface bluetooth-bond-store {
	/// The record for this controller and peer, key included. ANSWERED ONLY TO THE ONE HOLDER of
	/// this capability - "asked rather than read" means a typed confined operation and not a claim
	/// that the key is unnecessary.
	@op(1) lookup: func(local: peer-address, peer: peer-address) -> result<bond-record, error>;
	/// Store or replace a record. ATOMIC: a partially written bond is a key that decrypts nothing
	/// and a peer that cannot be paired again without being forgotten first.
	@op(2) store:  func(record: bond-record) -> result<unit, error>;
	/// Delete one. Answers `not-found` for a record that was not there, which is a different answer
	/// from a delete that failed.
	@op(3) delete: func(local: peer-address, peer: peer-address) -> result<unit, error>;
	/// Every record for this controller, WITHOUT KEY MATERIAL - the key field is empty. This is what
	/// the operator's `bonded` list is built from, and building it from `lookup` would mean reading
	/// every key to show a list of names.
	@op(4) list:   func(local: peer-address) -> result<list<bond-record>, error>;
}

// ------------------------------------------------------------------ development only

/// What one of the in-guest fixture's peers does next, on the gate's word.
enum fixture-action {
	/// Page this host and hold the link it accepts: an inbound connection.
	page          = 1,
	/// Open an L2CAP channel to the PSM `argument` names, on the link the peer holds.
	open-psm      = 2,
	/// Begin a pairing from the peer's side: authentication on the link it holds.
	pair          = 3,
	/// The link key type the peer's next pairing produces - how a downgrade is made.
	key-type      = 4,
	/// Type the passkey `argument` on the peer, as a person reading this host's display would.
	type-passkey  = 5,
	/// Ask this host's SDP server for the 16-bit service class `argument`; answers how many records matched.
	sdp-search    = 6,
	/// Open RFCOMM server channel `argument` on this host.
	rfcomm-open   = 7,
	/// Drop the link.
	disconnect    = 8,
	/// Forget the link key the peer holds, as a device reset to factory settings does.
	forget        = 9,
	/// Send `argument` bytes of data on the peer's open RFCOMM channel, to see credits flow.
	rfcomm-send   = 10,
	/// The keyboard presses Ctrl+Alt+Delete and lets go.
	ctrl-alt-delete = 11,
	/// The keyboard presses its Power key and lets go.
	power-key     = 12,
	/// A HID device opens its control and interrupt channels to this host, as one reconnecting does.
	hid-connect   = 13,
	/// The gamepad reports: buttons in `argument`'s low sixteen bits, its hat in the next four, X in the top byte.
	gamepad-report = 14,
	/// An LE device reads this host's name through this host's attribute server.
	read-host-name = 15,
	/// A dual-mode device's LE half begins advertising from its public address (`argument` 1), or stops and drops its
	/// LE link (0).
	le-advertise  = 16,
	/// The phone streams to this host over A2DP - configuring this host's sink - for `argument` seconds, a tone in one
	/// subband; or, with 0, stops.
	stream        = 17,
	/// The headset changes its own level to the absolute volume `argument`, and tells a controller registered for it.
	volume        = 18,
	/// The headset presses its play button toward this host.
	press-play    = 19,
	/// The headset's hands-free unit connects to this host's voice gateway - paging this host first where it has no
	/// link - and sets its service level connection up.
	hfp-connect   = 20,
	/// The headset's answer button (`ATA`), its hang-up (`AT+CHUP`), and its request for audio (`AT+BCC`); what this
	/// host answered is reported.
	answer        = 21,
	hang-up       = 22,
	audio-request = 23,
	/// The phone pushes this host an object of `argument` bytes over Object Push, five seconds from now - paging this
	/// host first where it has no link.
	push-object   = 24,
	/// The broadcast source begins its LE Audio broadcast - `argument` 1 in the clear, 2 encrypted with the fixture's
	/// Broadcast Code - or, with 0, ends it.
	broadcast     = 25,
	/// An earbud changes its own volume setting to `argument` (0 to 255), and notifies a client that asked.
	le-volume     = 26,
	/// An earbud writes this host's Call Control Point: opcode `argument` (0 accept, 1 terminate) on call index 1;
	/// what this host notified back is reported.
	le-call       = 27,
	/// THE CONTROLLER ITSELF (peer 0): its LE features from its next HCI Reset - `argument` 1 an LE Audio controller with
	/// extended advertising, periodic advertising sync, the CIS central role and the synchronized receiver, which
	/// refuses the legacy scan and connection commands once an extended one is used; 0 the controller it starts as,
	/// with none of them.
	le-features   = 28,
	/// The disconnected LE display fixture (peer 10): 0 DisplayOnly or 2 KeyboardOnly for the two SC passkey
	/// directions. Other peers or values are refused. This changes its next real SMP exchange, never its result.
	le-io-capability = 29,
	/// Save the disconnected non-audio LE peer's current keys, or explicitly restore that snapshot after a deliberately
	/// weaker pairing. `argument` must be zero. The guest's bond store is never touched; a reconnect must prove its key.
	le-save-keys    = 30,
	le-restore-keys = 31,
}

/// THE IN-GUEST BLUETOOTH FIXTURE'S CONTROL ENDPOINT. DEVELOPMENT ONLY: it exists on a development fixture
/// bound to a QEMU test device, reached through PermissionManager in a development build for a probe whose
/// policy row grants `fixture-control`. Its peers are numbered from 1 in the order the fixture documents; what
/// it reports is what the far side of the radio saw this host do.
interface bluetooth-fixture {
	/// One peer acts. The answer is the action's own result: an L2CAP connection result, a record count, a
	/// link handle - zero where there is nothing to say.
	@op(1) act:    func(peer: u8, action: fixture-action, argument: u32) -> result<u32, error>;
	/// What the far side saw since the last call, one line each, oldest first.
	@op(2) events: func() -> result<list<string>, error>;
	/// The keyboard types `text` - letters, digits, space, `-`, `.` and a newline as Enter - `delay-ms` from now, so a
	/// probe can end and leave the shell's prompt to read it.
	@op(3) type-text: func(peer: u8, @bound(64) text: string, delay-ms: u32) -> result<unit, error>;
}

// ------------------------------------------------------------------ audio, for AudioService

/// What a Bluetooth audio endpoint is, as AudioService's inventory takes it.
enum audio-endpoint-kind {
	/// Headphones or a speaker: A2DP, or an LE Audio sink.
	output = 1,
	/// A microphone streaming on its own: an LE Audio source.
	input  = 2,
	/// A headset's call audio both ways: HFP or HSP over SCO, or LE Audio's bidirectional streams. Its link is up only
	/// while it is open.
	voice  = 3,
	/// A PHONE PLAYING TO THIS SYSTEM - the A2DP sink route, or a broadcast this system receives: read as capture is,
	/// played to the default output, and never an input.
	route  = 4,
}

/// ONE ENDPOINT, as it is offered: its number on this connection, whose it is, and how it is driven - in the format
/// the device-side PCM contract states, its period acknowledgment its clock.
record audio-endpoint {
	id:              u32,
	peer:            peer-address,
	@bound(48) name: string,
	kind:            audio-endpoint-kind,
	rate:            u32,
	channels:        u8,
	latency-us:      u32,
	/// The device applies its level itself - AVRCP absolute volume, HFP's gains, LE Volume Control.
	hardware-volume: bool,
	volume:          u8,
}

/// A device's level changed on the device itself.
record endpoint-volume {
	id:     u32,
	volume: u8,
}

/// The call state AudioService relays from a voice session to the voice device.
enum bt-call-state {
	none     = 0,
	incoming = 1,
	outgoing = 2,
	active   = 3,
	held     = 4,
}

/// A headset's call command, relayed to AudioService.
enum bt-call-command {
	answer  = 1,
	hang-up = 2,
	reject  = 3,
	redial  = 4,
}

/// What the endpoints stream carries.
variant audio-event {
	/// An endpoint is offered.
	arrived(audio-endpoint),
	/// An endpoint is gone: its id.
	departed(u32),
	/// An endpoint's own level changed.
	volume(endpoint-volume),
	/// A voice device's call command.
	command(bt-call-command),
	/// An independent headset microphone gain changed. Existing variants retain their wire tags and payloads.
	microphone-volume(endpoint-volume),
}

/// BLUETOOTH'S AUDIO, FOR AUDIOSERVICE ALONE: resolved by name through the broker, never a role, so stopping the radio
/// stack stops no audio and no audio waits for the radio. Endpoints are offered as they come and go; each is opened as
/// a PCM channel speaking the device-side contract a sound card speaks; levels travel both ways; and the call relay
/// carries a voice session's call state out and a headset's commands in.
interface bluetooth-audio {
	/// The endpoints offered now, then every change, as a stream. One subscriber: a second is refused.
	@op(1) endpoints:  func() -> result<stream<audio-event>, error>;
	/// The PCM channel of an endpoint. Opening a voice endpoint brings its audio link up, and closing it takes it down.
	@op(2) open:       func(id: u32) -> result<handle<channel>, error>;
	@op(3) set-volume: func(id: u32, volume: u8) -> result<unit, error>;
	/// The call state the voice device reports; none when no session declares one.
	@op(4) set-call:   func(state: bt-call-state) -> result<unit, error>;
	/// The headset's current independent microphone level; unsupported where the profile offers no microphone control.
	@op(5) microphone-volume: func(id: u32) -> result<u8, error>;
	/// Independent HFP/HSP microphone gain, 0 to 100; does not alter the speaker level. Invalid above 100.
	/// Returns the actual level after the profile's gain quantization.
	@op(6) set-microphone-volume: func(id: u32, volume: u8) -> result<u8, error>;
}

/// A PAN LINK, offered to NetworkService: a network access point this host is a PAN user of.
record network-link {
	id:             u32,
	peer:           peer-address,
	@bound(64) name: string,
	/// Whether the operator said this link may replace a selected uplink: `btctl connect ADDRESS pan replace`.
	replace-uplink: bool,
}

/// What the links stream carries.
variant network-event {
	/// A link is up: the access point answered its setup.
	arrived(network-link),
	/// A link is gone - disconnected, lost, or its stack stopped: its id.
	departed(u32),
}

/// BLUETOOTH'S NETWORK LINKS, FOR NETWORKSERVICE ALONE: resolved by name through the broker, never a role, so no network
/// waits for the radio. A link opened is a frame channel speaking a NIC provider's frame-plus-link wire - the greeting,
/// `MAC` with the local controller's address and the 1500-byte MTU, then one Ethernet frame per message both ways - and
/// BNEP's framing is this service's. Closing it ends nothing but the channel; the link ends with the operator's
/// disconnect, or its peer.
interface bluetooth-network {
	/// The links offered now, then every change, as a stream. One subscriber: a second is refused.
	@op(1) links: func() -> result<stream<network-event>, error>;
	/// A link's frame channel. One holder.
	@op(2) open:  func(id: u32) -> result<handle<channel>, error>;
}
